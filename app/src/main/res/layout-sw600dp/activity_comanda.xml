<?xml version="1.0" encoding="utf-8"?>
<!--
    Comanda tablet (Stitch tablet_vista_de_comanda/code.html):
    panel de catalogo (65%) + panel de pedido (35%), ambos con colores exactos.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical"
    tools:context=".ui.comanda.ComandaActivity">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/barraComanda"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/surface_container_lowest"
        android:elevation="@dimen/elevacion_tarjeta"
        app:navigationContentDescription="@string/cd_volver"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:navigationIconTint="@color/stitch_primary"
        app:title="@string/comanda_barra_titulo"
        app:titleTextColor="@color/stitch_primary" />

    <!-- Contexto de la mesa -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/espacio_xl"
        android:paddingTop="@dimen/espacio_l">

        <TextView
            android:id="@+id/textoTitulo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/espacio_m"
            android:layout_weight="1"
            android:ellipsize="none"
            android:maxLines="2"
            android:textColor="@color/stitch_primary"
            android:textSize="@dimen/texto_titulo_pantalla"
            android:textStyle="bold"
            tools:text="Mesa 7 · Primer piso" />

        <TextView
            android:id="@+id/badgeEstado"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_badge_atencion"
            android:drawableStart="@drawable/ic_edit"
            android:drawablePadding="@dimen/espacio_xs"
            android:drawableTint="@color/tertiary"
            android:paddingHorizontal="@dimen/espacio_m"
            android:paddingVertical="@dimen/espacio_xs"
            android:text="@string/comanda_badge"
            android:textColor="@color/tertiary"
            android:textSize="@dimen/texto_secundario"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:padding="@dimen/espacio_xl">

        <!-- PANEL IZQUIERDO: catalogo -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="65"
            app:cardBackgroundColor="@color/surface_container_low"
            app:cardCornerRadius="@dimen/radio_tarjeta"
            app:cardElevation="@dimen/elevacion_tarjeta"
            app:strokeColor="@color/borde_suave"
            app:strokeWidth="@dimen/borde_tarjeta">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:padding="@dimen/espacio_l">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/comanda_catalogo_titulo"
                        android:textColor="@color/stitch_primary"
                        android:textSize="@dimen/texto_titulo_pantalla"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_pill_lima"
                        android:paddingHorizontal="@dimen/espacio_s"
                        android:paddingVertical="@dimen/espacio_xs"
                        android:text="@string/comanda_catalogo_demo"
                        android:textColor="@color/on_secondary_fixed"
                        android:textSize="@dimen/texto_etiqueta"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Categorias -->
                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/espacio_m"
                    android:scrollbars="none">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="44dp"
                            android:background="@drawable/bg_categoria_activa"
                            android:gravity="center"
                            android:paddingHorizontal="@dimen/espacio_l"
                            android:text="@string/comanda_categoria_entradas"
                            android:textColor="@color/on_primary"
                            android:textSize="@dimen/texto_secundario"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="44dp"
                            android:layout_marginStart="@dimen/espacio_s"
                            android:background="@drawable/bg_categoria_inactiva"
                            android:gravity="center"
                            android:paddingHorizontal="@dimen/espacio_l"
                            android:text="@string/comanda_categoria_fondos"
                            android:textColor="@color/on_surface"
                            android:textSize="@dimen/texto_secundario" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="44dp"
                            android:layout_marginStart="@dimen/espacio_s"
                            android:background="@drawable/bg_categoria_inactiva"
                            android:gravity="center"
                            android:paddingHorizontal="@dimen/espacio_l"
                            android:text="@string/comanda_categoria_bebidas"
                            android:textColor="@color/on_surface"
                            android:textSize="@dimen/texto_secundario" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="44dp"
                            android:layout_marginStart="@dimen/espacio_s"
                            android:background="@drawable/bg_categoria_inactiva"
                            android:gravity="center"
                            android:paddingHorizontal="@dimen/espacio_l"
                            android:text="@string/comanda_categoria_postres"
                            android:textColor="@color/on_surface"
                            android:textSize="@dimen/texto_secundario" />
                    </LinearLayout>
                </HorizontalScrollView>

                <!-- Buscador visual -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="@dimen/espacio_m"
                    android:background="@drawable/bg_campo_busqueda"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="@dimen/espacio_m">

                    <ImageView
                        android:layout_width="@dimen/icono_mediano"
                        android:layout_height="@dimen/icono_mediano"
                        android:contentDescription="@string/comanda_buscar_placeholder"
                        android:src="@drawable/ic_search"
                        app:tint="@color/on_surface_variant" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/espacio_s"
                        android:text="@string/comanda_buscar_placeholder"
                        android:textColor="@color/outline"
                        android:textSize="@dimen/texto_secundario" />
                </LinearLayout>

                <ScrollView
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginTop="@dimen/espacio_m"
                    android:layout_weight="1"
                    android:fillViewport="true"
                    android:scrollbars="none">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <!-- Platillo 1 -->
                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:cardBackgroundColor="@color/surface_container_lowest"
                            app:cardCornerRadius="@dimen/espacio_m"
                            app:cardElevation="@dimen/elevacion_tarjeta"
                            app:strokeWidth="0dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal"
                                android:padding="@dimen/espacio_m">

                                <com.google.android.material.card.MaterialCardView
                                    android:layout_width="@dimen/ancho_imagen_plato"
                                    android:layout_height="@dimen/alto_imagen_plato"
                                    app:cardBackgroundColor="@color/surface_container"
                                    app:cardCornerRadius="@dimen/espacio_m"
                                    app:cardElevation="0dp"
                                    app:strokeWidth="0dp">

                                    <ImageView
                                        android:layout_width="match_parent"
                                        android:layout_height="match_parent"
                                        android:contentDescription="@string/cd_imagen_ceviche"
                                        android:scaleType="centerCrop"
                                        android:src="@drawable/img_ceviche" />
                                </com.google.android.material.card.MaterialCardView>

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="@dimen/espacio_m"
                                    android:layout_weight="1"
                                    android:orientation="vertical">

                                    <TextView
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:ellipsize="none"
                                        android:maxLines="2"
                                        android:text="@string/comanda_plato_ceviche"
                                        android:textColor="@color/on_surface"
                                        android:textSize="@dimen/texto_cuerpo"
                                        android:textStyle="bold" />

                                    <TextView
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="2dp"
                                        android:text="@string/comanda_plato_ceviche_desc"
                                        android:textColor="@color/on_surface_variant"
                                        android:textSize="@dimen/texto_etiqueta" />

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="@dimen/espacio_xs"
                                        android:text="@string/comanda_precio_ceviche"
                                        android:textColor="@color/stitch_primary"
                                        android:textSize="@dimen/texto_titulo_tarjeta"
                                        android:textStyle="bold" />
                                </LinearLayout>

                                <com.google.android.material.button.MaterialButton
                                    style="@style/Boton.AgregarPlato"
                                    android:layout_width="@dimen/toque_minimo"
                                    android:layout_height="@dimen/toque_minimo"
                                    android:layout_marginStart="@dimen/espacio_m"
                                    android:contentDescription="@string/cd_agregar_ceviche"
                                    android:enabled="false"
                                    android:padding="0dp"
                                    app:icon="@drawable/ic_add"
                                    app:iconGravity="textStart"
                                    app:iconPadding="0dp" />
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>

                        <!-- Platillo 2 -->
                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/espacio_s"
                            app:cardBackgroundColor="@color/surface_container_lowest"
                            app:cardCornerRadius="@dimen/espacio_m"
                            app:cardElevation="@dimen/elevacion_tarjeta"
                            app:strokeWidth="0dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal"
                                android:padding="@dimen/espacio_m">

                                <com.google.android.material.card.MaterialCardView
                                    android:layout_width="@dimen/ancho_imagen_plato"
                                    android:layout_height="@dimen/alto_imagen_plato"
                                    app:cardBackgroundColor="@color/surface_container"
                                    app:cardCornerRadius="@dimen/espacio_m"
                                    app:cardElevation="0dp"
                                    app:strokeWidth="0dp">

                                    <ImageView
                                        android:layout_width="match_parent"
                                        android:layout_height="match_parent"
                                        android:contentDescription="@string/cd_imagen_tiradito"
                                        android:scaleType="centerCrop"
                                        android:src="@drawable/img_tiradito" />
                                </com.google.android.material.card.MaterialCardView>

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="@dimen/espacio_m"
                                    android:layout_weight="1"
                                    android:orientation="vertical">

                                    <TextView
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:ellipsize="none"
                                        android:maxLines="2"
                                        android:text="@string/comanda_plato_tiradito"
                                        android:textColor="@color/on_surface"
                                        android:textSize="@dimen/texto_cuerpo"
                                        android:textStyle="bold" />

                                    <TextView
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="2dp"
                                        android:text="@string/comanda_plato_tiradito_desc"
                                        android:textColor="@color/on_surface_variant"
                                        android:textSize="@dimen/texto_etiqueta" />

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="@dimen/espacio_xs"
                                        android:text="@string/comanda_precio_tiradito"
                                        android:textColor="@color/stitch_primary"
                                        android:textSize="@dimen/texto_titulo_tarjeta"
                                        android:textStyle="bold" />
                                </LinearLayout>

                                <com.google.android.material.button.MaterialButton
                                    style="@style/Boton.AgregarPlato"
                                    android:layout_width="@dimen/toque_minimo"
                                    android:layout_height="@dimen/toque_minimo"
                                    android:layout_marginStart="@dimen/espacio_m"
                                    android:contentDescription="@string/cd_agregar_tiradito"
                                    android:enabled="false"
                                    android:padding="0dp"
                                    app:icon="@drawable/ic_add"
                                    app:iconGravity="textStart"
                                    app:iconPadding="0dp" />
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>
                    </LinearLayout>
                </ScrollView>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- PANEL DERECHO: pedido actual -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="@dimen/espacio_l"
            android:layout_weight="35"
            app:cardBackgroundColor="@color/surface_container_lowest"
            app:cardCornerRadius="@dimen/radio_tarjeta"
            app:cardElevation="@dimen/elevacion_tarjeta_login"
            app:strokeColor="@color/borde_suave"
            app:strokeWidth="@dimen/borde_tarjeta">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:padding="@dimen/espacio_xl">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/comanda_pedido_titulo"
                    android:textColor="@color/on_surface"
                    android:textSize="@dimen/texto_titulo_pantalla"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/espacio_xs"
                    android:text="@string/comanda_pedido_subtitulo"
                    android:textColor="@color/on_surface_variant"
                    android:textSize="@dimen/texto_secundario" />

                <TextView
                    android:id="@+id/textoPedidoVacio"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginTop="@dimen/espacio_m"
                    android:layout_weight="1"
                    android:background="@drawable/bg_pill_superficie"
                    android:gravity="center"
                    android:padding="@dimen/espacio_l"
                    android:text="@string/comanda_pedido_vacio"
                    android:textColor="@color/on_surface_variant"
                    android:textSize="@dimen/texto_cuerpo" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/borde_tarjeta"
                    android:layout_marginVertical="@dimen/espacio_m"
                    android:background="@color/surface_variant" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/comanda_subtotal"
                        android:textColor="@color/on_surface_variant"
                        android:textSize="@dimen/texto_cuerpo" />

                    <TextView
                        android:id="@+id/textoSubtotal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/comanda_monto_cero"
                        android:textColor="@color/stitch_primary"
                        android:textSize="@dimen/texto_titulo_pantalla"
                        android:textStyle="bold" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnConfirmar"
                    style="@style/Boton.Primario"
                    android:layout_width="match_parent"
                    android:layout_marginTop="@dimen/espacio_m"
                    android:enabled="false"
                    android:text="@string/comanda_confirmar" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</LinearLayout>
