<?xml version="1.0" encoding="utf-8"?>
<!--
    Comanda tablet (rediseno PRB-38): catalogo a todo el ancho y barra
    flotante de checkout. El carrito se abre en CarritoBottomSheet; ya no
    existe el panel derecho estatico. Los IDs coinciden con el layout movil.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fitsSystemWindows="true"
    tools:context=".ui.comanda.ComandaActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/barraComanda"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/surface_container_lowest"
            android:elevation="@dimen/elevacion_tarjeta"
            app:menu="@menu/menu_comanda"
            app:navigationContentDescription="@string/cd_volver"
            app:navigationIcon="@drawable/ic_arrow_back"
            app:navigationIconTint="@color/stitch_primary"
            app:title="@string/comanda_barra_titulo"
            app:titleTextAppearance="@style/Texto.Toolbar"
            app:titleTextColor="@color/stitch_primary" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/espacio_xl"
            android:paddingTop="@dimen/espacio_l"
            android:paddingBottom="@dimen/espacio_checkout">

            <!-- Contexto de la mesa -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="@dimen/espacio_s">

                <TextView
                    android:id="@+id/textoTitulo"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/espacio_l"
                    android:layout_weight="1"
                    android:autoSizeMaxTextSize="28sp"
                    android:autoSizeMinTextSize="16sp"
                    android:autoSizeStepGranularity="1sp"
                    android:autoSizeTextType="uniform"
                    android:breakStrategy="simple"
                    android:ellipsize="none"
                    android:hyphenationFrequency="none"
                    android:maxLines="2"
                    android:textColor="@color/stitch_primary"
                    android:textSize="@dimen/texto_titulo_pantalla"
                    android:textStyle="bold"
                    tools:text="Mesa 7 · Primer piso" />

                <TextView
                    android:id="@+id/badgeEstado"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:autoSizeMaxTextSize="14sp"
                    android:autoSizeMinTextSize="11sp"
                    android:autoSizeStepGranularity="1sp"
                    android:autoSizeTextType="uniform"
                    android:background="@drawable/bg_badge_atencion"
                    android:breakStrategy="simple"
                    android:drawableStart="@drawable/ic_edit"
                    android:drawablePadding="@dimen/espacio_s"
                    android:drawableTint="@color/tertiary"
                    android:hyphenationFrequency="none"
                    android:paddingHorizontal="@dimen/espacio_l"
                    android:paddingVertical="@dimen/espacio_s"
                    android:text="@string/comanda_badge"
                    android:textColor="@color/tertiary"
                    android:textSize="@dimen/texto_secundario"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- PRB-83: avisar a caja que la mesa pidio la cuenta -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPedirCuenta"
                style="@style/Boton.Outlined"
                android:layout_width="match_parent"
                android:layout_height="@dimen/alto_boton_primario"
                android:layout_marginTop="@dimen/espacio_l"
                android:autoSizeMaxTextSize="16sp"
                android:autoSizeMinTextSize="11sp"
                android:autoSizeStepGranularity="1sp"
                android:autoSizeTextType="uniform"
                android:breakStrategy="simple"
                android:hyphenationFrequency="none"
                android:maxLines="1"
                android:text="@string/comanda_pedir_cuenta"
                app:icon="@drawable/ic_receipt"
                app:iconGravity="textStart"
                app:iconPadding="@dimen/espacio_s" />

            <!-- Catalogo agrupado por categorias -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="@dimen/espacio_l"
                android:layout_weight="1"
                app:cardBackgroundColor="@color/surface_container_lowest"
                app:cardCornerRadius="@dimen/radio_tarjeta"
                app:cardElevation="@dimen/elevacion_tarjeta"
                app:strokeColor="@color/borde_suave"
                app:strokeWidth="@dimen/borde_tarjeta">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:padding="@dimen/espacio_xl">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="@dimen/espacio_s"
                            android:layout_weight="1"
                            android:autoSizeMaxTextSize="24sp"
                            android:autoSizeMinTextSize="18sp"
                            android:autoSizeStepGranularity="1sp"
                            android:autoSizeTextType="uniform"
                            android:breakStrategy="simple"
                            android:hyphenationFrequency="none"
                            android:maxLines="1"
                            android:text="@string/comanda_catalogo_titulo"
                            android:textColor="@color/stitch_primary"
                            android:textSize="@dimen/texto_titulo_pantalla"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/textoModoDemo"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:autoSizeMaxTextSize="12sp"
                            android:autoSizeMinTextSize="10sp"
                            android:autoSizeStepGranularity="1sp"
                            android:autoSizeTextType="uniform"
                            android:background="@drawable/bg_pill_lima"
                            android:breakStrategy="simple"
                            android:hyphenationFrequency="none"
                            android:maxLines="2"
                            android:paddingHorizontal="@dimen/espacio_s"
                            android:paddingVertical="@dimen/espacio_xs"
                            android:text="@string/comanda_catalogo_demo"
                            android:textColor="@color/on_secondary_fixed"
                            android:textSize="@dimen/texto_etiqueta"
                            android:textStyle="bold"
                            android:visibility="gone"
                            tools:visibility="visible" />
                    </LinearLayout>

                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/espacio_l"
                        android:clipToPadding="false"
                        android:scrollbars="none">

                        <com.google.android.material.chip.ChipGroup
                            android:id="@+id/grupoCategorias"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:chipSpacingHorizontal="@dimen/espacio_s"
                            app:selectionRequired="true"
                            app:singleLine="true"
                            app:singleSelection="true" />
                    </HorizontalScrollView>

                    <ProgressBar
                        android:id="@+id/progresoCatalogo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginVertical="@dimen/espacio_xl"
                        android:indeterminateTint="@color/primary"
                        android:visibility="gone"
                        tools:visibility="visible" />

                    <LinearLayout
                        android:id="@+id/contenedorErrorCatalogo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_horizontal"
                        android:orientation="vertical"
                        android:paddingVertical="@dimen/espacio_xl"
                        android:visibility="gone">

                        <TextView
                            android:id="@+id/textoErrorCatalogo"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:autoSizeMaxTextSize="16sp"
                            android:autoSizeMinTextSize="12sp"
                            android:autoSizeStepGranularity="1sp"
                            android:autoSizeTextType="uniform"
                            android:breakStrategy="simple"
                            android:gravity="center"
                            android:hyphenationFrequency="none"
                            android:text="@string/comanda_catalogo_error"
                            android:textColor="@color/on_surface_variant"
                            android:textSize="@dimen/texto_cuerpo" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnReintentarCatalogo"
                            style="@style/Boton.Secundario"
                            android:layout_width="wrap_content"
                            android:layout_marginTop="@dimen/espacio_s"
                            android:text="@string/accion_reintentar" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/textoCatalogoVacio"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:autoSizeMaxTextSize="16sp"
                        android:autoSizeMinTextSize="12sp"
                        android:autoSizeStepGranularity="1sp"
                        android:autoSizeTextType="uniform"
                        android:breakStrategy="simple"
                        android:gravity="center"
                        android:hyphenationFrequency="none"
                        android:paddingVertical="@dimen/espacio_xl"
                        android:text="@string/comanda_catalogo_vacio"
                        android:textColor="@color/on_surface_variant"
                        android:textSize="@dimen/texto_cuerpo"
                        android:visibility="gone" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/listaCatalogo"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_marginTop="@dimen/espacio_s"
                        android:layout_weight="1"
                        android:clipToPadding="false"
                        android:overScrollMode="never"
                        android:visibility="gone"
                        tools:listitem="@layout/item_catalogo_producto" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </LinearLayout>

    <include
        android:id="@+id/barraCheckout"
        layout="@layout/barra_checkout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_margin="@dimen/espacio_l"
        android:visibility="gone" />
</FrameLayout>
