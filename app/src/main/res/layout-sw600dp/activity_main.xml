<?xml version="1.0" encoding="utf-8"?>
<!--
    Contenedor principal de la app (PRB-88), variante tablet (>= 600dp).
    NavegacionPrincipalView infla el NavigationRailView a la izquierda.
    El id y la clase son los mismos que en movil: MainActivity no distingue
    el tipo de dispositivo.
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fitsSystemWindows="true"
    tools:context=".ui.main.MainActivity">

    <com.lacasablanca.mesero.ui.main.NavegacionPrincipalView
        android:id="@+id/navegacionPrincipal"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/contenedorPrincipal"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/navegacionPrincipal"
        app:layout_constraintTop_toTopOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
