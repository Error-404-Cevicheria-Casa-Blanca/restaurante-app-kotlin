<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardMesa"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    android:clickable="true"
    android:focusable="true"
    android:minHeight="224dp"
    app:cardBackgroundColor="@color/transparent"
    app:cardCornerRadius="22dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/mesa_libre_cb"
    app:strokeWidth="1dp">

    <LinearLayout
        android:id="@+id/contenidoMesa"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:minHeight="224dp"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="14dp">

        <!-- Mantiene el texto compuesto "Mesa N" accesible para pruebas de navegacion Espresso -->
        <TextView
            android:id="@+id/textoMesa"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:importantForAccessibility="no"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="top"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/textoEtiquetaMesa"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter"
                    android:includeFontPadding="false"
                    android:text="@string/mesa_solo_etiqueta"
                    android:textColor="@color/marea_tx2"
                    android:textFontWeight="500"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/textoNumeroMesa"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:autoSizeMaxTextSize="@dimen/texto_numero_mesa"
                    android:autoSizeMinTextSize="28sp"
                    android:autoSizeStepGranularity="1sp"
                    android:autoSizeTextType="uniform"
                    android:fontFamily="@font/lora"
                    android:fontFeatureSettings="tnum"
                    android:includeFontPadding="false"
                    android:lineSpacingExtra="0dp"
                    android:maxLines="1"
                    android:textColor="@color/marea_tx"
                    android:textFontWeight="700"
                    android:textSize="@dimen/texto_numero_mesa"
                    android:textStyle="bold"
                    tools:text="1" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginEnd="4dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_people"
                    app:tint="@color/marea_tx2" />

                <TextView
                    android:id="@+id/textoCapacidad"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter"
                    android:includeFontPadding="false"
                    android:textColor="@color/marea_tx2"
                    android:textFontWeight="600"
                    android:textSize="14sp"
                    tools:text="4" />

                <ImageButton
                    android:id="@+id/btnAccionesMesa"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginEnd="-6dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@null"
                    android:padding="8dp"
                    android:src="@drawable/ic_more_vert"
                    app:tint="@color/marea_tx2" />
            </LinearLayout>
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:paddingVertical="8dp">

            <com.lacasablanca.mesero.ui.common.MesaCroquisView
                android:id="@+id/croquisMesa"
                android:layout_width="wrap_content"
                android:layout_height="88dp"
                android:layout_gravity="center" />
        </FrameLayout>

        <LinearLayout
            android:id="@+id/ribbonEstado"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginEnd="-16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingEnd="20dp">

            <ImageView
                android:id="@+id/iconoEstado"
                android:layout_width="15dp"
                android:layout_height="15dp"
                android:layout_marginEnd="6dp"
                android:importantForAccessibility="no"
                tools:src="@drawable/ic_marea_libre" />

            <TextView
                android:id="@+id/textoEstado"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="@font/inter"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textFontWeight="700"
                android:textSize="12.5sp"
                tools:text="Libre" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
