<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_marea_app"
    android:baselineAligned="false"
    android:orientation="horizontal"
    tools:context=".ui.login.LoginActivity">

    <!-- PANEL IZQUIERDO MAREA OCEANICA (560dp en 1280dp, adaptable en sw600dp) -->
    <FrameLayout
        android:id="@+id/heroLogin"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="5"
        android:background="@drawable/bg_hero_login_tablet">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:importantForAccessibility="no"
            android:scaleType="fitXY"
            android:src="@drawable/bg_hero_waves_tablet" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="40dp">

            <FrameLayout
                android:layout_width="@dimen/logo_tablet"
                android:layout_height="@dimen/logo_tablet"
                android:background="@drawable/bg_logo_hero_ring"
                android:elevation="16dp"
                android:padding="6dp">

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/logoLogin"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@color/white"
                    android:contentDescription="@string/marca_descripcion_logo"
                    android:scaleType="centerCrop"
                    android:src="@drawable/logo_casa_blanca"
                    app:shapeAppearanceOverlay="@style/ShapeAppearance.Marea.Circulo" />
            </FrameLayout>

            <TextView
                style="@style/Texto.MarcaTablet"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:gravity="center"
                android:text="@string/marca_nombre" />

            <TextView
                style="@style/Texto.LemaMarca"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="@string/marca_lema"
                android:textSize="19sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:background="@drawable/bg_pill_sede"
                android:fontFamily="@font/inter_bold"
                android:gravity="center"
                android:minHeight="32dp"
                android:paddingHorizontal="14dp"
                android:paddingVertical="6dp"
                android:text="@string/marca_sede"
                android:textColor="@color/white"
                android:textSize="13sp" />
        </LinearLayout>
    </FrameLayout>

    <!-- PANEL DERECHO CON TARJETA 460DP -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollLogin"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="7"
        android:fillViewport="true">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="24dp"
            android:paddingVertical="32dp">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/tarjetaLogin"
                style="@style/Tarjeta.Login"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toTopOf="@id/versionApp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_chainStyle="packed"
                app:layout_constraintWidth_max="@dimen/ancho_panel_login">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="32dp">

                    <TextView
                        style="@style/Texto.TituloPantalla"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/login_titulo"
                        android:textSize="34sp" />

                    <TextView
                        style="@style/Texto.Secundario"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="@string/login_subtitulo"
                        android:textSize="16sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="22dp"
                        android:layout_marginBottom="8dp"
                        android:fontFamily="@font/inter_semibold"
                        android:text="@string/login_usuario"
                        android:textColor="@color/marea_tx2"
                        android:textSize="13sp" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/inputUsuario"
                        style="@style/Campo.Marea"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:hintEnabled="false"
                        app:startIconContentDescription="@string/login_usuario"
                        app:startIconDrawable="@drawable/ic_person"
                        app:startIconTint="@color/marea_tx3">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/entradaUsuario"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/alto_campo_login"
                            android:fontFamily="@font/inter_medium"
                            android:hint="@string/login_usuario"
                            android:imeOptions="actionNext"
                            android:inputType="textPersonName"
                            android:maxLines="1"
                            android:textColor="@color/marea_tx"
                            android:textColorHint="@color/marea_tx3"
                            android:textSize="16sp" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:layout_marginBottom="8dp"
                        android:fontFamily="@font/inter_semibold"
                        android:text="@string/login_clave"
                        android:textColor="@color/marea_tx2"
                        android:textSize="13sp" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/inputClave"
                        style="@style/Campo.Marea"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:endIconContentDescription="@string/login_mostrar_clave"
                        app:endIconDrawable="@drawable/ic_visibility"
                        app:endIconMode="custom"
                        app:endIconTint="@color/marea_tx2"
                        app:hintEnabled="false"
                        app:startIconContentDescription="@string/login_clave"
                        app:startIconDrawable="@drawable/ic_lock"
                        app:startIconTint="@color/marea_tx3">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/entradaClave"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/alto_campo_login"
                            android:fontFamily="@font/inter_medium"
                            android:hint="@string/login_clave"
                            android:imeOptions="actionDone"
                            android:inputType="textPassword"
                            android:maxLines="1"
                            android:textColor="@color/marea_tx"
                            android:textColorHint="@color/marea_tx3"
                            android:textSize="16sp" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <TextView
                        android:id="@+id/textoError"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:accessibilityLiveRegion="polite"
                        android:background="@drawable/bg_error_banner"
                        android:drawablePadding="10dp"
                        android:fontFamily="@font/inter_semibold"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="16dp"
                        android:paddingVertical="12dp"
                        android:textColor="@color/marea_banner_err_fg"
                        android:textSize="14sp"
                        android:visibility="gone"
                        app:drawableStartCompat="@drawable/ic_alert_triangle"
                        app:drawableTint="@color/marea_banner_err_fg"
                        tools:text="@string/login_error_credenciales"
                        tools:visibility="visible" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnIngresar"
                        style="@style/Boton.Primario"
                        android:layout_width="match_parent"
                        android:layout_marginTop="22dp"
                        android:text="@string/login_ingresar"
                        app:icon="@drawable/ic_arrow_forward"
                        app:iconGravity="textEnd" />

                    <ProgressBar
                        android:id="@+id/progresoLogin"
                        android:layout_width="@dimen/icono_grande"
                        android:layout_height="@dimen/icono_grande"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="10dp"
                        android:indeterminate="true"
                        android:indeterminateTint="@color/marea_cyh"
                        android:visibility="gone"
                        tools:visibility="visible" />

                    <TextView
                        android:id="@+id/avisoDemo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="22dp"
                        android:background="@drawable/bg_banner_demo"
                        android:drawablePadding="10dp"
                        android:fontFamily="@font/inter_semibold"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="16dp"
                        android:paddingVertical="12dp"
                        android:text="@string/login_modo_demo"
                        android:textColor="@color/marea_banner_demo_fg"
                        android:textSize="13.5sp"
                        android:visibility="gone"
                        app:drawableStartCompat="@drawable/ic_info_circle"
                        app:drawableTint="@color/marea_banner_demo_fg"
                        tools:visibility="visible" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/versionApp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:fontFamily="@font/inter"
                android:textColor="@color/marea_tx3"
                android:textSize="13sp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tarjetaLogin"
                tools:text="Versión 1.0 · Cevichería Restaurante" />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
