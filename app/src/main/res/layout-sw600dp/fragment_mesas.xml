<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".ui.salon.SalonFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="32dp"
        android:paddingTop="26dp">

        <include
            android:id="@+id/barra"
            layout="@layout/barra_mesas" />

        <LinearLayout
            android:id="@+id/bannerOffline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_banner_warn"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:paddingVertical="12dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_wifi_off"
                app:tint="@color/marea_banner_warn_fg" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:fontFamily="@font/inter"
                android:text="@string/offline_banner"
                android:textColor="@color/marea_banner_warn_fg"
                android:textFontWeight="600"
                android:textSize="14sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical">

            <com.google.android.material.tabs.TabLayout
                android:id="@+id/tabsZonas"
                android:layout_width="wrap_content"
                android:layout_height="50dp"
                android:background="@drawable/bg_contenedor_zonas"
                android:padding="5dp"
                app:tabBackground="@drawable/selector_tab_zona"
                app:tabGravity="start"
                app:tabIndicatorHeight="0dp"
                app:tabMinWidth="0dp"
                app:tabMode="scrollable"
                app:tabPaddingEnd="16dp"
                app:tabPaddingStart="16dp"
                app:tabRippleColor="@null"
                app:tabTextAppearance="@style/Texto.PestanaZona"
                app:tabTextColor="@color/selector_texto_tab_zona" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/chipsEstados"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="start|center_vertical"
                    android:orientation="horizontal" />
            </HorizontalScrollView>
        </LinearLayout>
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerMesas"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingHorizontal="24dp"
            android:paddingTop="4dp"
            android:paddingBottom="8dp"
            tools:listitem="@layout/item_mesa" />

        <FrameLayout
            android:id="@+id/progresoCarga"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingTop="4dp"
            android:visibility="gone">

            <include layout="@layout/view_mesa_skeleton_grid" />
        </FrameLayout>

        <LinearLayout
            android:id="@+id/grupoError"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingHorizontal="32dp"
            android:visibility="gone">

            <FrameLayout
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@drawable/bg_ib_err">

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_alert_triangle"
                    app:tint="@color/sem_err_c" />
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="@font/plus_jakarta_sans"
                android:gravity="center"
                android:text="@string/mesas_error"
                android:textColor="@color/marea_tx"
                android:textFontWeight="800"
                android:textSize="22sp" />

            <TextView
                android:id="@+id/textoErrorMesas"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="@font/inter"
                android:gravity="center"
                android:lineSpacingMultiplier="1.3"
                android:maxWidth="420dp"
                android:text="@string/mesas_error_ayuda"
                android:textColor="@color/marea_tx2"
                android:textSize="15sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnReintentar"
                style="@style/Boton.Primario"
                android:layout_width="wrap_content"
                android:layout_height="52dp"
                android:layout_marginTop="16dp"
                android:paddingHorizontal="32dp"
                android:text="@string/accion_reintentar"
                app:icon="@drawable/ic_refresh"
                app:iconPadding="8dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/grupoVacio"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingHorizontal="32dp"
            android:visibility="gone">

            <FrameLayout
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@drawable/bg_ib_info">

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_nav_salon"
                    app:tint="@color/sem_info_c" />
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="@font/plus_jakarta_sans"
                android:gravity="center"
                android:text="@string/mesas_vacio"
                android:textColor="@color/marea_tx"
                android:textFontWeight="800"
                android:textSize="22sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="@font/inter"
                android:gravity="center"
                android:lineSpacingMultiplier="1.3"
                android:maxWidth="420dp"
                android:text="@string/mesas_vacio_ayuda"
                android:textColor="@color/marea_tx2"
                android:textSize="15sp" />
        </LinearLayout>
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="32dp"
        android:paddingTop="12dp"
        android:paddingBottom="24dp">

        <HorizontalScrollView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="16dp"
            android:layout_weight="1"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="18dp"
                    android:fontFamily="@font/inter"
                    android:includeFontPadding="false"
                    android:letterSpacing="0.1"
                    android:text="@string/leyenda_estados_mesa"
                    android:textAllCaps="true"
                    android:textColor="@color/marea_tx3"
                    android:textFontWeight="600"
                    android:textSize="12sp" />

                <LinearLayout
                    android:id="@+id/leyendaEstados"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal" />
            </LinearLayout>
        </HorizontalScrollView>

        <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
            android:id="@+id/fabParaLlevar"
            android:layout_width="wrap_content"
            android:layout_height="56dp"
            android:contentDescription="@string/cd_para_llevar"
            android:fontFamily="@font/plus_jakarta_sans"
            android:paddingHorizontal="24dp"
            android:text="@string/para_llevar_accion"
            android:textAllCaps="false"
            android:textColor="@color/marea_oncy"
            android:textFontWeight="800"
            android:textSize="16sp"
            app:backgroundTint="@color/marea_cy"
            app:elevation="6dp"
            app:icon="@drawable/ic_marea_para_llevar"
            app:iconPadding="10dp"
            app:iconTint="@color/marea_oncy"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.Marea.Fab" />
    </LinearLayout>
</LinearLayout>
