<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_marea_app"
    android:baselineAligned="false"
    android:fitsSystemWindows="true"
    android:orientation="horizontal"
    tools:context=".ui.bloqueo.BloqueoActivity">

    <!-- PANEL IZQUIERDO: IDENTIDAD + PUNTOS PIN -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollBloqueo"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="40dp">

            <FrameLayout
                android:layout_width="@dimen/logo_bloqueo"
                android:layout_height="@dimen/logo_bloqueo"
                android:background="@drawable/bg_logo_hero_ring"
                android:elevation="10dp"
                android:padding="3dp">

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/logoBloqueo"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@color/white"
                    android:contentDescription="@string/marca_descripcion_logo"
                    android:scaleType="centerCrop"
                    android:src="@drawable/logo_casa_blanca"
                    app:shapeAppearanceOverlay="@style/ShapeAppearance.Marea.Circulo" />
            </FrameLayout>

            <TextView
                android:id="@+id/tituloBloqueo"
                style="@style/Texto.TituloPantalla"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:text="@string/bloqueo_titulo"
                android:textSize="34sp" />

            <TextView
                android:id="@+id/subtituloBloqueo"
                style="@style/Texto.Secundario"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="@string/bloqueo_subtitulo"
                android:textSize="17sp" />

            <TextView
                android:id="@+id/textoUsuario"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_pill_superficie"
                android:drawablePadding="6dp"
                android:fontFamily="@font/inter_bold"
                android:gravity="center"
                android:maxLines="1"
                android:minHeight="30dp"
                android:paddingHorizontal="12dp"
                android:paddingVertical="4dp"
                android:textColor="@color/marea_tx2"
                android:textSize="13sp"
                android:visibility="gone"
                app:drawableStartCompat="@drawable/ic_person"
                app:drawableTint="@color/marea_tx2"
                tools:text="Sesión de mozo"
                tools:visibility="visible" />

            <LinearLayout
                android:id="@+id/puntosPin"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:contentDescription="@string/bloqueo_puntos_descripcion"
                android:focusable="true"
                android:gravity="center"
                android:importantForAccessibility="yes"
                android:orientation="horizontal"
                android:padding="4dp">

                <View
                    android:id="@+id/punto1"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_marginHorizontal="8dp"
                    android:background="@drawable/bg_punto_pin"
                    android:importantForAccessibility="no" />

                <View
                    android:id="@+id/punto2"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_marginHorizontal="8dp"
                    android:background="@drawable/bg_punto_pin"
                    android:importantForAccessibility="no" />

                <View
                    android:id="@+id/punto3"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_marginHorizontal="8dp"
                    android:background="@drawable/bg_punto_pin"
                    android:importantForAccessibility="no" />

                <View
                    android:id="@+id/punto4"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_marginHorizontal="8dp"
                    android:background="@drawable/bg_punto_pin"
                    android:importantForAccessibility="no" />
            </LinearLayout>

            <TextView
                android:id="@+id/textoError"
                android:layout_width="380dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:accessibilityLiveRegion="assertive"
                android:background="@drawable/bg_error_banner"
                android:drawablePadding="10dp"
                android:fontFamily="@font/inter_semibold"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp"
                android:paddingVertical="12dp"
                android:textColor="@color/marea_banner_err_fg"
                android:textSize="14sp"
                android:visibility="gone"
                app:drawableStartCompat="@drawable/ic_alert_triangle"
                app:drawableTint="@color/marea_banner_err_fg"
                tools:text="PIN incorrecto. Inténtalo de nuevo."
                tools:visibility="visible" />

            <ProgressBar
                android:id="@+id/progresoVerificando"
                android:layout_width="@dimen/icono_grande"
                android:layout_height="@dimen/icono_grande"
                android:layout_marginTop="14dp"
                android:indeterminate="true"
                android:indeterminateTint="@color/marea_cyh"
                android:visibility="gone"
                tools:visibility="visible" />

            <TextView
                android:id="@+id/textoVerificando"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="@font/inter_semibold"
                android:gravity="center"
                android:text="@string/bloqueo_verificando"
                android:textColor="@color/marea_tx2"
                android:textSize="14sp"
                android:visibility="gone"
                tools:visibility="visible" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- PANEL DERECHO: TECLADO NUMERICO + PIN DEMO -->
    <LinearLayout
        android:layout_width="460dp"
        android:layout_height="match_parent"
        android:background="@drawable/bg_panel_bloqueo"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="40dp">

        <LinearLayout
            android:id="@+id/tecladoBloqueo"
            android:layout_width="340dp"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnTecla1"
                    style="@style/Boton.PinTecla"
                    android:layout_width="0dp"
                    android:layout_marginEnd="14dp"
                    android:layout_weight="1"
                    android:text="@string/bloqueo_tecla_1" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnTecla2"
                    style="@style/Boton.PinTecla"
                    android:layout_width="0dp"
                    android:layout_marginEnd="14dp"
                    android:layout_weight="1"
                    android:text="@string/bloqueo_tecla_2" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnTecla3"
                    style="@style/Boton.PinTecla"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:text="@string/bloqueo_tecla_3" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnTecla4"
                    style="@style/Boton.PinTecla"
                    android:layout_width="0dp"
                    android:layout_marginEnd="14dp"
                    android:layout_weight="1"
                    android:text="@string/bloqueo_tecla_4" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnTecla5"
                    style="@style/Boton.PinTecla"
                    android:layout_width="0dp"
                    android:layout_marginEnd="14dp"
                    android:layout_weight="1"
                    android:text="@string/bloqueo_tecla_5" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnTecla6"
                    style="@style/Boton.PinTecla"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:text="@string/bloqueo_tecla_6" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnTecla7"
                    style="@style/Boton.PinTecla"
                    android:layout_width="0dp"
                    android:layout_marginEnd="14dp"
                    android:layout_weight="1"
                    android:text="@string/bloqueo_tecla_7" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnTecla8"
                    style="@style/Boton.PinTecla"
                    android:layout_width="0dp"
                    android:layout_marginEnd="14dp"
                    android:layout_weight="1"
                    android:text="@string/bloqueo_tecla_8" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnTecla9"
                    style="@style/Boton.PinTecla"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:text="@string/bloqueo_tecla_9" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal">

                <Space
                    android:layout_width="0dp"
                    android:layout_height="@dimen/alto_pin_tecla"
                    android:layout_marginEnd="14dp"
                    android:layout_weight="1" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnTecla0"
                    style="@style/Boton.PinTecla"
                    android:layout_width="0dp"
                    android:layout_marginEnd="14dp"
                    android:layout_weight="1"
                    android:text="@string/bloqueo_tecla_0" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnBorrar"
                    style="@style/Boton.PinAccion"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:contentDescription="@string/bloqueo_borrar"
                    app:icon="@drawable/ic_backspace"
                    app:iconGravity="textStart"
                    app:iconPadding="0dp"
                    app:iconTint="@color/marea_tx" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/textoPinDemo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:background="@drawable/bg_pill_demo"
            android:fontFamily="@font/inter_bold"
            android:gravity="center"
            android:maxLines="1"
            android:minHeight="30dp"
            android:paddingHorizontal="14dp"
            android:paddingVertical="4dp"
            android:textColor="@color/marea_banner_demo_fg"
            android:textSize="13sp"
            android:visibility="gone"
            tools:text="PIN de demostración: 1234"
            tools:visibility="visible" />
    </LinearLayout>
</LinearLayout>
