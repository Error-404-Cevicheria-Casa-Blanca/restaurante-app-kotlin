<?xml version="1.0" encoding="utf-8"?>
<!-- Encabezado de categoria del catalogo: jerarquia tipografica y aire. -->
<TextView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/textoEncabezadoCategoria"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:autoSizeMaxTextSize="14sp"
    android:autoSizeMinTextSize="11sp"
    android:autoSizeStepGranularity="1sp"
    android:autoSizeTextType="uniform"
    android:breakStrategy="simple"
    android:ellipsize="none"
    android:hyphenationFrequency="none"
    android:letterSpacing="0.04"
    android:maxLines="2"
    android:paddingTop="@dimen/espacio_l"
    android:paddingBottom="@dimen/espacio_s"
    android:textAllCaps="true"
    android:textColor="@color/stitch_primary"
    android:textSize="13sp"
    android:textStyle="bold"
    tools:text="PLATOS DE FONDO" />
