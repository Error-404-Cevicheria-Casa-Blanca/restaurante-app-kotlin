<?xml version="1.0" encoding="utf-8"?>
<!--
    Placeholder de los destinos durante la Fase 1 de PRB-88.
    Se reemplaza por el layout real de cada fragmento en las fases 2 y 3.
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:padding="@dimen/espacio_xl">

    <TextView
        android:id="@+id/textoPlaceholder"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:autoSizeMaxTextSize="28sp"
        android:autoSizeMinTextSize="18sp"
        android:autoSizeStepGranularity="1sp"
        android:autoSizeTextType="uniform"
        android:breakStrategy="simple"
        android:gravity="center"
        android:hyphenationFrequency="none"
        android:maxLines="1"
        android:textColor="@color/texto_principal"
        android:textSize="@dimen/texto_titulo_pantalla"
        android:textStyle="bold"
        app:layout_constraintBottom_toTopOf="@id/textoPlaceholderDetalle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"
        tools:text="Salón" />

    <TextView
        android:id="@+id/textoPlaceholderDetalle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/espacio_m"
        android:autoSizeMaxTextSize="16sp"
        android:autoSizeMinTextSize="12sp"
        android:autoSizeStepGranularity="1sp"
        android:autoSizeTextType="uniform"
        android:breakStrategy="simple"
        android:gravity="center"
        android:hyphenationFrequency="none"
        android:maxLines="2"
        android:text="@string/nav_placeholder_detalle"
        android:textColor="@color/texto_secundario"
        android:textSize="@dimen/texto_cuerpo"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/textoPlaceholder" />
</androidx.constraintlayout.widget.ConstraintLayout>
