<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/barraSuperiorSalon"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <com.google.android.material.imageview.ShapeableImageView
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:background="@color/white"
        android:contentDescription="@string/marca_descripcion_logo"
        android:scaleType="centerCrop"
        android:src="@drawable/logo_casa_blanca"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.Marea.Circulo" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="@font/plus_jakarta_sans"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="@string/mesas_titulo"
            android:textColor="@color/marea_tx"
            android:textFontWeight="800"
            android:textSize="17sp" />

        <TextView
            android:id="@+id/textoSaludo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:fontFamily="@font/inter"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="@color/marea_tx2"
            android:textSize="12.5sp"
            tools:text="Hola, Mozo Demo" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/btnActualizar"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/bg_btn_icon"
        android:contentDescription="@string/cd_actualizar"
        android:padding="9dp"
        android:scaleType="centerInside"
        android:src="@drawable/ic_refresh"
        app:tint="@color/marea_cyh" />

    <ImageButton
        android:id="@+id/btnPerfil"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="8dp"
        android:background="@drawable/bg_btn_icon"
        android:contentDescription="@string/cd_abrir_perfil"
        android:padding="9dp"
        android:scaleType="centerInside"
        android:src="@drawable/ic_person"
        android:visibility="gone"
        app:tint="@color/marea_tx" />

    <ImageButton
        android:id="@+id/btnBloquear"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="8dp"
        android:background="@drawable/bg_btn_icon"
        android:contentDescription="@string/cd_bloquear"
        android:padding="9dp"
        android:scaleType="centerInside"
        android:src="@drawable/ic_lock"
        app:tint="@color/marea_tx" />

    <ImageButton
        android:id="@+id/btnCerrarSesion"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="8dp"
        android:background="@drawable/bg_btn_icon"
        android:contentDescription="@string/cd_cerrar_sesion"
        android:padding="9dp"
        android:scaleType="centerInside"
        android:src="@drawable/ic_logout"
        app:tint="@color/error" />
</LinearLayout>
