<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialogo_premium"
    android:orientation="vertical"
    android:paddingStart="22dp"
    android:paddingTop="26dp"
    android:paddingEnd="22dp"
    android:paddingBottom="22dp">

    <FrameLayout
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/bg_ib_info">

        <ImageView
            android:id="@+id/iconoDividir"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center"
            android:contentDescription="@null"
            android:src="@drawable/ic_call_split"
            app:tint="@color/sem_info_c" />
    </FrameLayout>

    <TextView
        android:id="@+id/tituloDividir"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="center"
        android:textAppearance="@style/Texto.TituloPantalla"
        android:textColor="@color/marea_tx"
        android:textSize="18sp"
        android:textStyle="bold"
        tools:text="Dividir cuenta · Mesa 4" />

    <TextView
        android:id="@+id/mensajeDividir"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:lineSpacingExtra="2dp"
        android:textColor="@color/marea_tx2"
        android:textSize="13sp"
        tools:text="Selecciona los platos que pasarán a la nueva cuenta." />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/listaItemsDividir"
        android:layout_width="match_parent"
        android:layout_height="@dimen/alto_lista_destinos"
        android:layout_marginTop="14dp"
        android:clipToPadding="false"
        android:overScrollMode="never"
        tools:listitem="@layout/item_division_linea" />

    <TextView
        android:id="@+id/errorDividir"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:text="@string/division_seleccion_requerida"
        android:textColor="@color/sem_err_c"
        android:textSize="12sp"
        android:visibility="gone"
        tools:visibility="visible" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnContinuarDividir"
            style="@style/Boton.Primario"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/division_continuar" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCancelarDividir"
            style="@style/Boton.Outlined"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/accion_cancelar" />
    </LinearLayout>

</LinearLayout>
