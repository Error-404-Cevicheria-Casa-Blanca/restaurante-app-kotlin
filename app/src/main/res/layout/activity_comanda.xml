<?xml version="1.0" encoding="utf-8"?>
<!--
    Comanda movil (PRB-38): una sola columna con el catalogo agrupado por
    categorias y, debajo, el carrito con subtotal, IGV (18%), total y el
    boton "Confirmar y Enviar". Los IDs deben coincidir con layout-sw600dp.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    tools:context=".ui.comanda.ComandaActivity">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/barraComanda"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/surface_container_lowest"
        android:elevation="@dimen/elevacion_tarjeta"
        app:navigationContentDescription="@string/cd_volver"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:navigationIconTint="@color/stitch_primary"
        app:title="@string/comanda_barra_titulo"
        app:titleTextColor="@color/stitch_primary" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:scrollbars="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/espacio_l"
            android:paddingBottom="@dimen/espacio_xxl">

            <!-- Contexto de la mesa -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Tarjeta.Superficie"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="@dimen/espacio_m">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/espacio_m">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/textoTitulo"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="@dimen/espacio_s"
                            android:layout_weight="1"
                            android:autoSizeMaxTextSize="20sp"
                            android:autoSizeMinTextSize="14sp"
                            android:autoSizeStepGranularity="1sp"
                            android:autoSizeTextType="uniform"
                            android:breakStrategy="simple"
                            android:ellipsize="none"
                            android:hyphenationFrequency="none"
                            android:maxLines="2"
                            android:textColor="@color/stitch_primary"
                            android:textSize="@dimen/texto_titulo_tarjeta"
                            android:textStyle="bold"
                            tools:text="Mesa 7 · Primer piso" />

                        <TextView
                            android:id="@+id/badgeEstado"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_badge_atencion"
                            android:breakStrategy="simple"
                            android:drawableStart="@drawable/ic_edit"
                            android:drawablePadding="@dimen/espacio_xs"
                            android:drawableTint="@color/tertiary"
                            android:hyphenationFrequency="none"
                            android:paddingHorizontal="@dimen/espacio_m"
                            android:paddingVertical="@dimen/espacio_xs"
                            android:text="@string/comanda_badge"
                            android:textColor="@color/tertiary"
                            android:textSize="@dimen/texto_etiqueta"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Filtros de categoria (dinamicos desde GET /categorias) -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espacio_m"
                android:clipToPadding="false"
                android:scrollbars="none">

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/grupoCategorias"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:chipSpacingHorizontal="@dimen/espacio_s"
                    app:selectionRequired="true"
                    app:singleLine="true"
                    app:singleSelection="true" />
            </HorizontalScrollView>

            <!-- Catalogo agrupado por categorias -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Tarjeta.Superficie"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espacio_m"
                app:cardCornerRadius="@dimen/radio_tarjeta">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/espacio_m">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="@dimen/espacio_s"
                            android:layout_weight="1"
                            android:breakStrategy="simple"
                            android:hyphenationFrequency="none"
                            android:text="@string/comanda_catalogo_titulo"
                            android:textColor="@color/stitch_primary"
                            android:textSize="@dimen/texto_titulo_tarjeta"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/textoModoDemo"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:autoSizeMaxTextSize="12sp"
                            android:autoSizeMinTextSize="10sp"
                            android:autoSizeStepGranularity="1sp"
                            android:autoSizeTextType="uniform"
                            android:background="@drawable/bg_pill_lima"
                            android:breakStrategy="simple"
                            android:hyphenationFrequency="none"
                            android:maxLines="2"
                            android:paddingHorizontal="@dimen/espacio_s"
                            android:paddingVertical="@dimen/espacio_xs"
                            android:text="@string/comanda_catalogo_demo"
                            android:textColor="@color/on_secondary_fixed"
                            android:textSize="@dimen/texto_etiqueta"
                            android:textStyle="bold"
                            android:visibility="gone"
                            tools:visibility="visible" />
                    </LinearLayout>

                    <ProgressBar
                        android:id="@+id/progresoCatalogo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginVertical="@dimen/espacio_l"
                        android:indeterminateTint="@color/primary"
                        android:visibility="gone"
                        tools:visibility="visible" />

                    <LinearLayout
                        android:id="@+id/contenedorErrorCatalogo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_horizontal"
                        android:orientation="vertical"
                        android:paddingVertical="@dimen/espacio_l"
                        android:visibility="gone">

                        <TextView
                            android:id="@+id/textoErrorCatalogo"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:breakStrategy="simple"
                            android:gravity="center"
                            android:hyphenationFrequency="none"
                            android:text="@string/comanda_catalogo_error"
                            android:textColor="@color/on_surface_variant"
                            android:textSize="@dimen/texto_secundario" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnReintentarCatalogo"
                            style="@style/Boton.Secundario"
                            android:layout_width="wrap_content"
                            android:layout_marginTop="@dimen/espacio_s"
                            android:text="@string/accion_reintentar" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/textoCatalogoVacio"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:breakStrategy="simple"
                        android:gravity="center"
                        android:hyphenationFrequency="none"
                        android:paddingVertical="@dimen/espacio_l"
                        android:text="@string/comanda_catalogo_vacio"
                        android:textColor="@color/on_surface_variant"
                        android:textSize="@dimen/texto_secundario"
                        android:visibility="gone" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/listaCatalogo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/espacio_s"
                        android:clipToPadding="false"
                        android:nestedScrollingEnabled="false"
                        android:overScrollMode="never"
                        android:visibility="gone"
                        tools:listitem="@layout/item_catalogo_producto" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Carrito -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Tarjeta.Superficie"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espacio_m"
                app:cardCornerRadius="@dimen/radio_tarjeta">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/espacio_l">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:breakStrategy="simple"
                                android:hyphenationFrequency="none"
                                android:text="@string/comanda_pedido_titulo"
                                android:textColor="@color/on_surface"
                                android:textSize="@dimen/texto_titulo_tarjeta"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:breakStrategy="simple"
                                android:hyphenationFrequency="none"
                                android:text="@string/comanda_pedido_subtitulo"
                                android:textColor="@color/on_surface_variant"
                                android:textSize="@dimen/texto_etiqueta" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/textoContadorItems"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:breakStrategy="simple"
                            android:hyphenationFrequency="none"
                            android:textColor="@color/on_surface_variant"
                            android:textSize="@dimen/texto_etiqueta"
                            tools:text="2 ítems" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/textoPedidoVacio"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/espacio_s"
                        android:background="@drawable/bg_pill_superficie"
                        android:breakStrategy="simple"
                        android:hyphenationFrequency="none"
                        android:padding="@dimen/espacio_m"
                        android:text="@string/comanda_pedido_vacio"
                        android:textColor="@color/on_surface_variant"
                        android:textSize="@dimen/texto_secundario" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/listaCarrito"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/alto_lista_carrito_movil"
                        android:layout_marginTop="@dimen/espacio_s"
                        android:clipToPadding="false"
                        android:nestedScrollingEnabled="true"
                        android:overScrollMode="never"
                        android:scrollbars="vertical"
                        android:visibility="gone"
                        tools:listitem="@layout/item_carrito" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/borde_tarjeta"
                        android:layout_marginVertical="@dimen/espacio_m"
                        android:background="@color/surface_variant" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:breakStrategy="simple"
                            android:hyphenationFrequency="none"
                            android:text="@string/comanda_subtotal"
                            android:textColor="@color/on_surface_variant"
                            android:textSize="@dimen/texto_cuerpo" />

                        <TextView
                            android:id="@+id/textoSubtotal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:autoSizeMaxTextSize="18sp"
                            android:autoSizeMinTextSize="12sp"
                            android:autoSizeStepGranularity="1sp"
                            android:autoSizeTextType="uniform"
                            android:breakStrategy="simple"
                            android:hyphenationFrequency="none"
                            android:text="@string/comanda_monto_cero"
                            android:textColor="@color/stitch_primary"
                            android:textSize="18sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/espacio_xs"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:breakStrategy="simple"
                            android:hyphenationFrequency="none"
                            android:text="@string/comanda_igv"
                            android:textColor="@color/on_surface_variant"
                            android:textSize="@dimen/texto_secundario" />

                        <TextView
                            android:id="@+id/textoIgv"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:autoSizeMaxTextSize="14sp"
                            android:autoSizeMinTextSize="12sp"
                            android:autoSizeStepGranularity="1sp"
                            android:autoSizeTextType="uniform"
                            android:breakStrategy="simple"
                            android:hyphenationFrequency="none"
                            android:text="@string/comanda_monto_cero"
                            android:textColor="@color/on_surface_variant"
                            android:textSize="@dimen/texto_secundario" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/espacio_xs"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:breakStrategy="simple"
                            android:hyphenationFrequency="none"
                            android:text="@string/comanda_total"
                            android:textColor="@color/on_surface"
                            android:textSize="@dimen/texto_cuerpo"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/textoTotal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:autoSizeMaxTextSize="20sp"
                            android:autoSizeMinTextSize="14sp"
                            android:autoSizeStepGranularity="1sp"
                            android:autoSizeTextType="uniform"
                            android:breakStrategy="simple"
                            android:hyphenationFrequency="none"
                            android:text="@string/comanda_monto_cero"
                            android:textColor="@color/stitch_primary"
                            android:textSize="@dimen/texto_titulo_tarjeta"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnConfirmar"
                        style="@style/Boton.Exito"
                        android:layout_width="match_parent"
                        android:layout_marginTop="@dimen/espacio_m"
                        android:enabled="false"
                        android:text="@string/comanda_confirmar" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
