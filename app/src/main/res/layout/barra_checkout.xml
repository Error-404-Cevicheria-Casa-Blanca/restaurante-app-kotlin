<?xml version="1.0" encoding="utf-8"?>
<!--
    Barra flotante de checkout (rediseno PRB-38). Se incluye al fondo de
    activity_comanda.xml (movil y tablet) con margen de 16dp, radio 16dp y
    elevacion 8dp. Solo se muestra cuando el carrito tiene items.
-->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="@color/surface_container_lowest"
    app:cardCornerRadius="@dimen/radio_checkout"
    app:cardElevation="@dimen/elevacion_checkout"
    app:strokeColor="@color/borde_suave"
    app:strokeWidth="@dimen/borde_tarjeta">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="@dimen/espacio_l">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/espacio_l"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/textoBarraItems"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:autoSizeMaxTextSize="14sp"
                android:autoSizeMinTextSize="11sp"
                android:autoSizeStepGranularity="1sp"
                android:autoSizeTextType="uniform"
                android:breakStrategy="simple"
                android:ellipsize="none"
                android:hyphenationFrequency="none"
                android:maxLines="1"
                android:textColor="@color/on_surface_variant"
                android:textSize="@dimen/texto_etiqueta"
                android:textStyle="bold"
                tools:text="2 ítems" />

            <TextView
                android:id="@+id/textoBarraTotal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:autoSizeMaxTextSize="20sp"
                android:autoSizeMinTextSize="14sp"
                android:autoSizeStepGranularity="1sp"
                android:autoSizeTextType="uniform"
                android:breakStrategy="simple"
                android:ellipsize="none"
                android:hyphenationFrequency="none"
                android:maxLines="1"
                android:textColor="@color/stitch_primary"
                android:textSize="18sp"
                android:textStyle="bold"
                tools:text="Total: S/ 96.00" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnVerCarrito"
            style="@style/Boton.Checkout"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/alto_boton_checkout"
            android:text="@string/checkout_ver_carrito"
            app:icon="@drawable/ic_receipt_blanco"
            app:iconGravity="textStart"
            app:iconPadding="@dimen/espacio_s"
            app:iconTint="@color/on_primary" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
