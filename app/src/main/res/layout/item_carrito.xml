<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_item_carrito"
    android:orientation="vertical"
    android:paddingStart="14dp"
    android:paddingTop="14dp"
    android:paddingEnd="14dp"
    android:paddingBottom="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="top"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/textoNombreCarrito"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:breakStrategy="simple"
                android:fontFamily="@font/plus_jakarta_sans_extrabold"
                android:hyphenationFrequency="none"
                android:includeFontPadding="false"
                android:lineSpacingMultiplier="1.15"
                android:textColor="@color/marea_tx"
                android:textSize="16.5sp"
                tools:text="Tiradito al Ají Amarillo" />

            <TextView
                android:id="@+id/textoPrecioCarrito"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="@font/inter_semibold"
                android:fontFeatureSettings="tnum"
                android:includeFontPadding="false"
                android:textColor="@color/marea_tx2"
                android:textSize="13sp"
                tools:text="S/ 46.00 c/u · S/ 92.00" />

            <TextView
                android:id="@+id/textoModificadoresCarrito"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="@font/inter"
                android:textColor="@color/marea_tx2"
                android:textSize="12.5sp"
                android:visibility="gone"
                tools:text="Sin cebolla, Extra leche de tigre (+S/ 2.00)"
                tools:visibility="visible" />

            <TextView
                android:id="@+id/textoNotaCarrito"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_pill_superficie"
                android:drawablePadding="6dp"
                android:fontFamily="@font/inter_semibold"
                android:gravity="center_vertical"
                android:paddingStart="10dp"
                android:paddingTop="5dp"
                android:paddingEnd="10dp"
                android:paddingBottom="5dp"
                android:textColor="@color/marea_tx2"
                android:textSize="12.5sp"
                android:visibility="gone"
                app:drawableStartCompat="@drawable/ic_edit"
                app:drawableTint="@color/marea_tx2"
                tools:text="Nota: sin ají"
                tools:visibility="visible" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:orientation="vertical">

            <TextView
                android:id="@+id/textoYaPedido"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_pill_superficie"
                android:fontFamily="@font/inter_bold"
                android:paddingStart="10dp"
                android:paddingTop="4dp"
                android:paddingEnd="10dp"
                android:paddingBottom="4dp"
                android:text="@string/comanda_ya_pedido"
                android:textColor="@color/marea_tx2"
                android:textSize="11.5sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/textoEstadoPlato"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_pill_estado_plato"
                android:fontFamily="@font/inter_bold"
                android:paddingStart="10dp"
                android:paddingTop="4dp"
                android:paddingEnd="10dp"
                android:paddingBottom="4dp"
                android:textSize="11.5sp"
                android:visibility="gone"
                tools:text="En preparación"
                tools:visibility="visible" />

            <ImageButton
                android:id="@+id/btnAnular"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_btn_danger_icon"
                android:padding="13dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_marea_trash"
                android:visibility="gone"
                app:tint="@color/error"
                tools:visibility="gone" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/filaControles"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/btnNota"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_btn_icon"
            android:padding="13dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_edit"
            app:tint="@color/marea_cyh" />

        <ImageButton
            android:id="@+id/btnEliminar"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_btn_danger_icon"
            android:padding="13dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_marea_trash"
            app:tint="@color/error" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_qty_marea"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="3dp">

            <ImageButton
                android:id="@+id/btnDisminuir"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_qty_minus_marea"
                android:contentDescription="@null"
                android:padding="12dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_marea_minus"
                app:tint="@color/marea_tx" />

            <TextView
                android:id="@+id/textoCantidad"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/plus_jakarta_sans_extrabold"
                android:fontFeatureSettings="tnum"
                android:gravity="center"
                android:minWidth="32dp"
                android:textColor="@color/marea_tx"
                android:textSize="16sp"
                tools:text="2" />

            <ImageButton
                android:id="@+id/btnAumentar"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_qty_plus_marea"
                android:contentDescription="@null"
                android:padding="12dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_marea_plus"
                app:tint="@color/marea_oncy" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
