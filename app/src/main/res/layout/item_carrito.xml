<?xml version="1.0" encoding="utf-8"?>
<!--
    Linea del carrito (movil y tablet): nombre/precio arriba y controles en
    una segunda fila. Asi el nombre usa todo el ancho y los tres botones
    conservan 48dp de objetivo tactil sin desbordar el panel derecho.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingVertical="@dimen/espacio_xs">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/textoNombreCarrito"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/espacio_s"
            android:layout_weight="1"
            android:autoSizeMaxTextSize="16sp"
            android:autoSizeMinTextSize="11sp"
            android:autoSizeStepGranularity="1sp"
            android:autoSizeTextType="uniform"
            android:breakStrategy="simple"
            android:hyphenationFrequency="none"
            android:maxLines="2"
            android:textColor="@color/on_surface"
            android:textSize="14sp"
            android:textStyle="bold"
            tools:text="Ceviche Clásico La Casa Blanca" />

        <ImageButton
            android:id="@+id/btnNota"
            android:layout_width="@dimen/toque_minimo"
            android:layout_height="@dimen/toque_minimo"
            android:background="@drawable/bg_boton_cantidad"
            android:contentDescription="@string/cd_nota"
            android:padding="12dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_edit"
            android:tint="@color/stitch_primary" />
    </LinearLayout>

    <TextView
        android:id="@+id/textoPrecioCarrito"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:autoSizeMaxTextSize="12sp"
        android:autoSizeMinTextSize="10sp"
        android:autoSizeStepGranularity="1sp"
        android:autoSizeTextType="uniform"
        android:breakStrategy="simple"
        android:hyphenationFrequency="none"
        android:maxLines="2"
        android:textColor="@color/on_surface_variant"
        android:textSize="12sp"
        tools:text="S/ 48.00 c/u · S/ 96.00" />

    <TextView
        android:id="@+id/textoNotaCarrito"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/espacio_xs"
        android:autoSizeMaxTextSize="12sp"
        android:autoSizeMinTextSize="10sp"
        android:autoSizeStepGranularity="1sp"
        android:autoSizeTextType="uniform"
        android:background="@drawable/bg_pill_superficie"
        android:breakStrategy="simple"
        android:hyphenationFrequency="none"
        android:maxLines="4"
        android:paddingHorizontal="@dimen/espacio_s"
        android:paddingVertical="2dp"
        android:textColor="@color/stitch_primary"
        android:textSize="12sp"
        android:visibility="gone"
        tools:text="Nota: sin picante"
        tools:visibility="visible" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/espacio_xs"
        android:gravity="end"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/btnDisminuir"
            android:layout_width="@dimen/toque_minimo"
            android:layout_height="@dimen/toque_minimo"
            android:background="@drawable/bg_boton_cantidad"
            android:contentDescription="@string/cd_disminuir"
            android:padding="12dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_remove"
            android:tint="@color/stitch_primary" />

        <TextView
            android:id="@+id/textoCantidad"
            android:layout_width="@dimen/ancho_cantidad_carrito"
            android:layout_height="wrap_content"
            android:breakStrategy="simple"
            android:gravity="center"
            android:hyphenationFrequency="none"
            android:textColor="@color/on_surface"
            android:textSize="16sp"
            android:textStyle="bold"
            tools:text="2" />

        <ImageButton
            android:id="@+id/btnAumentar"
            android:layout_width="@dimen/toque_minimo"
            android:layout_height="@dimen/toque_minimo"
            android:background="@drawable/bg_boton_cantidad"
            android:contentDescription="@string/cd_aumentar"
            android:padding="12dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_add"
            android:tint="@color/stitch_primary" />

        <ImageButton
            android:id="@+id/btnEliminar"
            android:layout_width="@dimen/toque_minimo"
            android:layout_height="@dimen/toque_minimo"
            android:layout_marginStart="@dimen/espacio_xs"
            android:background="@drawable/bg_boton_cantidad"
            android:contentDescription="@string/cd_eliminar"
            android:padding="12dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_delete"
            android:tint="@color/estado_ocupada" />
    </LinearLayout>
</LinearLayout>
