<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_marea_app"
    android:orientation="vertical"
    tools:context=".ui.cobro.CobroFragment">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/barraCobro"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/transparent"
        android:elevation="0dp"
        android:minHeight="56dp"
        android:paddingStart="6dp"
        android:paddingTop="6dp"
        android:paddingEnd="6dp"
        app:contentInsetStartWithNavigation="0dp"
        app:menu="@menu/menu_cobro"
        app:navigationContentDescription="@string/cd_volver"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:navigationIconTint="@color/marea_tx"
        app:titleTextColor="@color/transparent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingTop="4dp"
            android:paddingEnd="4dp"
            android:paddingBottom="4dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/textoTituloCobro"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:autoSizeMaxTextSize="20sp"
                    android:autoSizeMinTextSize="15sp"
                    android:autoSizeStepGranularity="1sp"
                    android:autoSizeTextType="uniform"
                    android:fontFamily="@font/plus_jakarta_sans_extrabold"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:textColor="@color/marea_tx"
                    android:textSize="20sp"
                    tools:text="Cobrar Mesa 5" />

                <TextView
                    android:id="@+id/badgeEstadoCobro"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/bg_badge_cuenta"
                    android:drawablePadding="5dp"
                    android:fontFamily="@font/inter_bold"
                    android:gravity="center_vertical"
                    android:includeFontPadding="false"
                    android:minHeight="24dp"
                    android:paddingStart="10dp"
                    android:paddingTop="3dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="3dp"
                    android:text="@string/estado_cuenta"
                    android:textColor="@color/estado_cuenta"
                    android:textSize="12sp"
                    android:visibility="gone"
                    app:drawableStartCompat="@drawable/ic_marea_cta"
                    app:drawableTint="@color/estado_cuenta"
                    tools:visibility="visible" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/btnImprimir"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_btn_icon"
                android:contentDescription="@string/impresion_imprimir"
                android:padding="10dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_print"
                app:tint="@color/marea_tx" />
        </LinearLayout>
    </com.google.android.material.appbar.MaterialToolbar>

    <ProgressBar
        android:id="@+id/progresoCobro"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginVertical="@dimen/espacio_xxl"
        android:indeterminateTint="@color/marea_cyh"
        android:visibility="gone"
        tools:visibility="gone" />

    <LinearLayout
        android:id="@+id/grupoErrorCobro"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="28dp"
        android:visibility="gone"
        tools:visibility="gone">

        <FrameLayout
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:background="@drawable/bg_ib_err">

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_alert_triangle"
                app:tint="@color/sem_err_c" />
        </FrameLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:breakStrategy="simple"
            android:fontFamily="@font/plus_jakarta_sans_extrabold"
            android:gravity="center"
            android:hyphenationFrequency="none"
            android:text="@string/cobro_error_carga_titulo"
            android:textColor="@color/marea_tx"
            android:textSize="20sp" />

        <TextView
            android:id="@+id/textoErrorCobro"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:autoSizeMaxTextSize="15sp"
            android:autoSizeMinTextSize="11sp"
            android:autoSizeStepGranularity="1sp"
            android:autoSizeTextType="uniform"
            android:breakStrategy="simple"
            android:fontFamily="@font/inter"
            android:gravity="center"
            android:hyphenationFrequency="none"
            android:maxLines="3"
            android:text="@string/cobro_error_carga"
            android:textColor="@color/marea_tx2"
            android:textSize="14.5sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnReintentarCobro"
            style="@style/Boton.Primario"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/alto_boton_primario"
            android:layout_marginTop="20dp"
            android:paddingStart="28dp"
            android:paddingEnd="28dp"
            android:text="@string/cobro_reintentar" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/contenidoCobro"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:visibility="gone"
        tools:visibility="visible">

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:scrollbars="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingTop="6dp"
                android:paddingEnd="16dp"
                android:paddingBottom="16dp">

                <com.google.android.material.card.MaterialCardView
                    style="@style/Tarjeta.Superficie"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="@color/marea_s1"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/marea_line"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/plus_jakarta_sans_extrabold"
                            android:includeFontPadding="false"
                            android:maxLines="1"
                            android:text="@string/cobro_resumen_titulo"
                            android:textColor="@color/marea_tx"
                            android:textSize="18sp" />

                        <TextView
                            android:id="@+id/textoCuentaVacia"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:fontFamily="@font/inter"
                            android:gravity="center"
                            android:maxLines="2"
                            android:text="@string/cobro_resumen_vacio"
                            android:textColor="@color/marea_tx2"
                            android:textSize="13.5sp"
                            android:visibility="gone" />

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/recyclerCuenta"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:clipToPadding="false"
                            android:nestedScrollingEnabled="false"
                            android:overScrollMode="never"
                            tools:listitem="@layout/item_cuenta_linea" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingVertical="3dp">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:fontFamily="@font/inter"
                                android:maxLines="1"
                                android:text="@string/cobro_subtotal"
                                android:textColor="@color/marea_tx2"
                                android:textSize="13.5sp" />

                            <TextView
                                android:id="@+id/textoSubtotal"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/plus_jakarta_sans_bold"
                                android:fontFeatureSettings="tnum"
                                android:maxLines="1"
                                android:textColor="@color/marea_tx"
                                android:textSize="14sp"
                                tools:text="S/ 81.36" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingVertical="3dp">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:fontFamily="@font/inter"
                                android:maxLines="1"
                                android:text="@string/cobro_igv"
                                android:textColor="@color/marea_tx2"
                                android:textSize="13.5sp" />

                            <TextView
                                android:id="@+id/textoIgv"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/plus_jakarta_sans_bold"
                                android:fontFeatureSettings="tnum"
                                android:maxLines="1"
                                android:textColor="@color/marea_tx"
                                android:textSize="14sp"
                                tools:text="S/ 14.64" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/filaDescuento"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingVertical="4dp"
                            android:visibility="gone"
                            tools:visibility="visible">

                            <TextView
                                android:id="@+id/textoDescuento"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/inter_bold"
                                android:maxLines="1"
                                android:textColor="@color/sem_warn_c"
                                android:textSize="13.5sp"
                                tools:text="Descuento (10%): -S/ 9.60" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:background="@drawable/bg_total_marea"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingStart="14dp"
                            android:paddingTop="12dp"
                            android:paddingEnd="14dp"
                            android:paddingBottom="12dp">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:fontFamily="@font/plus_jakarta_sans_extrabold"
                                android:includeFontPadding="false"
                                android:maxLines="1"
                                android:text="@string/cobro_total"
                                android:textColor="@color/marea_tx"
                                android:textSize="16sp" />

                            <TextView
                                android:id="@+id/textoTotal"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/plus_jakarta_sans_extrabold"
                                android:fontFeatureSettings="tnum"
                                android:includeFontPadding="false"
                                android:maxLines="1"
                                android:textColor="@color/marea_cyh"
                                android:textSize="22sp"
                                tools:text="S/ 96.00" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/filaAccionesResumen"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:baselineAligned="false"
                            android:orientation="horizontal">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnAplicarDescuento"
                                style="@style/Boton.Outlined"
                                android:layout_width="0dp"
                                android:layout_height="46dp"
                                android:layout_marginEnd="8dp"
                                android:layout_weight="1"
                                android:autoSizeMaxTextSize="14.5sp"
                                android:autoSizeMinTextSize="10.5sp"
                                android:autoSizeStepGranularity="1sp"
                                android:autoSizeTextType="uniform"
                                android:maxLines="1"
                                android:paddingStart="8dp"
                                android:paddingEnd="8dp"
                                android:text="@string/cobro_descuento_corto"
                                app:icon="@drawable/ic_descuento"
                                app:iconGravity="textStart"
                                app:iconPadding="5dp"
                                app:iconSize="16dp"
                                app:iconTint="@color/marea_tx" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnReimprimir"
                                style="@style/Boton.Outlined"
                                android:layout_width="0dp"
                                android:layout_height="46dp"
                                android:layout_weight="1"
                                android:autoSizeMaxTextSize="14.5sp"
                                android:autoSizeMinTextSize="10.5sp"
                                android:autoSizeStepGranularity="1sp"
                                android:autoSizeTextType="uniform"
                                android:maxLines="1"
                                android:paddingStart="8dp"
                                android:paddingEnd="8dp"
                                android:text="@string/impresion_reimprimir"
                                app:icon="@drawable/ic_refresh"
                                app:iconGravity="textStart"
                                app:iconPadding="5dp"
                                app:iconSize="16dp"
                                app:iconTint="@color/marea_tx" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/grupoEstadoImpresion"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:orientation="vertical"
                            android:visibility="gone">

                            <TextView
                                android:id="@+id/txtEstadoImpresion"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:accessibilityLiveRegion="polite"
                                android:textColor="@color/marea_tx"
                                android:textSize="13sp"
                                tools:text="En cola de impresión…" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnReintentar"
                                style="@style/Boton.Outlined"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:minHeight="44dp"
                                android:text="@string/impresion_reintentar"
                                android:visibility="gone"
                                app:icon="@drawable/ic_refresh"
                                app:iconGravity="textStart"
                                app:iconPadding="6dp"
                                app:iconSize="17dp"
                                app:iconTint="@color/marea_tx" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    style="@style/Tarjeta.Superficie"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    app:cardBackgroundColor="@color/marea_s1"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/marea_line"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/plus_jakarta_sans_extrabold"
                            android:includeFontPadding="false"
                            android:maxLines="1"
                            android:text="@string/cobro_medios_pago"
                            android:textColor="@color/marea_tx"
                            android:textSize="18sp" />

                        <HorizontalScrollView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:overScrollMode="never"
                            android:scrollbars="none">

                            <com.google.android.material.chip.ChipGroup
                                android:id="@+id/grupoMediosPago"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                app:chipSpacingHorizontal="8dp"
                                app:selectionRequired="true"
                                app:singleLine="true"
                                app:singleSelection="true">

                            <com.google.android.material.chip.Chip
                                android:id="@+id/chipEfectivo"
                                style="@style/Chip.MedioPago"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:checked="true"
                                android:text="@string/cobro_efectivo"
                                app:chipIcon="@drawable/ic_cobrar_marea"
                                app:chipIconSize="16dp"
                                app:chipIconTint="@color/selector_texto_chip_categoria"
                                app:chipIconVisible="true" />

                            <com.google.android.material.chip.Chip
                                android:id="@+id/chipYape"
                                style="@style/Chip.MedioPago"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/cobro_yape"
                                app:chipIcon="@drawable/ic_marea_yape"
                                app:chipIconSize="16dp"
                                app:chipIconTint="@color/selector_texto_chip_categoria"
                                app:chipIconVisible="true" />

                            <com.google.android.material.chip.Chip
                                android:id="@+id/chipPlin"
                                style="@style/Chip.MedioPago"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/cobro_plin"
                                app:chipIcon="@drawable/ic_marea_plin"
                                app:chipIconSize="16dp"
                                app:chipIconTint="@color/selector_texto_chip_categoria"
                                app:chipIconVisible="true" />

                            <com.google.android.material.chip.Chip
                                android:id="@+id/chipTarjeta"
                                style="@style/Chip.MedioPago"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/cobro_tarjeta"
                                app:chipIcon="@drawable/ic_marea_tarjeta"
                                app:chipIconSize="16dp"
                                app:chipIconTint="@color/selector_texto_chip_categoria"
                                app:chipIconVisible="true" />
                        </com.google.android.material.chip.ChipGroup>
                        </HorizontalScrollView>

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/campoMontoPago"
                            style="@style/Campo.Marea"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:hint="@string/cobro_monto_pago"
                            app:prefixText="S/ ">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/textoMontoPago"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/plus_jakarta_sans_bold"
                                android:fontFeatureSettings="tnum"
                                android:imeOptions="actionNext"
                                android:inputType="numberDecimal"
                                android:maxLines="1"
                                android:textColor="@color/marea_tx"
                                android:textSize="16sp" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <TextView
                            android:id="@+id/textoVuelto"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:background="@drawable/bg_banner_ok"
                            android:drawablePadding="8dp"
                            android:fontFamily="@font/inter_bold"
                            android:fontFeatureSettings="tnum"
                            android:gravity="center_vertical"
                            android:maxLines="1"
                            android:paddingStart="12dp"
                            android:paddingTop="8dp"
                            android:paddingEnd="12dp"
                            android:paddingBottom="8dp"
                            android:textColor="@color/sem_ok_c"
                            android:textSize="13.5sp"
                            app:drawableStartCompat="@drawable/ic_cobrar_marea"
                            app:drawableTint="@color/sem_ok_c"
                            tools:text="Vuelto: S/ 0.00" />

                        <TextView
                            android:id="@+id/textoMontoACobrar"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:fontFamily="@font/inter_bold"
                            android:fontFeatureSettings="tnum"
                            android:maxLines="1"
                            android:textColor="@color/marea_cyh"
                            android:textSize="14sp"
                            android:visibility="gone"
                            tools:text="Monto a cobrar: S/ 96.00" />

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/campoReferencia"
                            style="@style/Campo.Marea"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:hint="@string/cobro_referencia"
                            android:visibility="gone">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/textoReferencia"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/inter_medium"
                                android:imeOptions="actionNext"
                                android:inputType="text"
                                android:maxLines="1"
                                android:textColor="@color/marea_tx"
                                android:textSize="15.5sp" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/campoPropina"
                            style="@style/Campo.Marea"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:hint="@string/cobro_propina"
                            app:prefixText="S/ ">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/textoPropina"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/plus_jakarta_sans_bold"
                                android:fontFeatureSettings="tnum"
                                android:imeOptions="actionDone"
                                android:inputType="numberDecimal"
                                android:maxLines="1"
                                android:textColor="@color/marea_tx"
                                android:textSize="16sp" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <TextView
                            android:id="@+id/textoPropinaSugerida"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:fontFamily="@font/inter"
                            android:fontFeatureSettings="tnum"
                            android:maxLines="1"
                            android:textColor="@color/marea_tx2"
                            android:textSize="12.5sp"
                            tools:text="Propina sugerida: S/ 9.60" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnAgregarPago"
                            style="@style/Boton.Primario"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/alto_boton_mediano"
                            android:layout_marginTop="14dp"
                            android:text="@string/cobro_agregar_pago"
                            app:icon="@drawable/ic_marea_plus"
                            app:iconGravity="textStart"
                            app:iconPadding="8dp"
                            app:iconSize="18dp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    style="@style/Tarjeta.Superficie"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    app:cardBackgroundColor="@color/marea_s1"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/marea_line"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/plus_jakarta_sans_extrabold"
                            android:includeFontPadding="false"
                            android:maxLines="1"
                            android:text="@string/cobro_pagos_titulo"
                            android:textColor="@color/marea_tx"
                            android:textSize="18sp" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/textoPagado"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/inter_bold"
                                android:fontFeatureSettings="tnum"
                                android:maxLines="1"
                                android:textColor="@color/sem_ok_c"
                                android:textSize="14sp"
                                tools:text="Pagado: S/ 0.00" />

                            <TextView
                                android:id="@+id/textoSaldoPendiente"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:fontFamily="@font/inter_bold"
                                android:fontFeatureSettings="tnum"
                                android:maxLines="1"
                                android:textColor="@color/marea_cyh"
                                android:textSize="14sp"
                                tools:text="Saldo pendiente: S/ 96.00" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/textoSinPagos"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:fontFamily="@font/inter"
                            android:gravity="center"
                            android:maxLines="2"
                            android:text="@string/cobro_sin_pagos"
                            android:textColor="@color/marea_tx2"
                            android:textSize="13.5sp" />

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/recyclerPagos"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:clipToPadding="false"
                            android:nestedScrollingEnabled="false"
                            android:overScrollMode="never"
                            tools:listitem="@layout/item_pago" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    style="@style/Tarjeta.Superficie"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    app:cardBackgroundColor="@color/marea_s1"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/marea_line"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <FrameLayout
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:background="@drawable/bg_icon_box_cy">

                                <ImageView
                                    android:layout_width="20dp"
                                    android:layout_height="20dp"
                                    android:layout_gravity="center"
                                    android:importantForAccessibility="no"
                                    android:src="@drawable/ic_marea_split"
                                    app:tint="@color/marea_cyh" />
                            </FrameLayout>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="12dp"
                                android:layout_marginEnd="10dp"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="@font/plus_jakarta_sans_extrabold"
                                    android:includeFontPadding="false"
                                    android:maxLines="1"
                                    android:text="@string/cobro_dividir_titulo"
                                    android:textColor="@color/marea_tx"
                                    android:textSize="16.5sp" />

                                <TextView
                                    android:id="@+id/textoResumenDivision"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="3dp"
                                    android:fontFamily="@font/inter"
                                    android:maxLines="2"
                                    android:text="@string/cobro_dividir_descripcion"
                                    android:textColor="@color/marea_tx2"
                                    android:textSize="12.5sp" />
                            </LinearLayout>

                            <com.google.android.material.materialswitch.MaterialSwitch
                                android:id="@+id/switchDividirCuenta"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:contentDescription="@string/cd_dividir_cuenta" />
                        </LinearLayout>

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/recyclerCuotas"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:clipToPadding="false"
                            android:nestedScrollingEnabled="false"
                            android:overScrollMode="never"
                            android:visibility="gone"
                            tools:listitem="@layout/item_cuota"
                            tools:visibility="visible" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </FrameLayout>

    <LinearLayout
        android:id="@+id/barraInferior"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginTop="6dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="10dp"
        android:background="@drawable/bg_checkout_marea"
        android:elevation="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="14dp"
        android:paddingBottom="12dp"
        android:visibility="gone"
        tools:visibility="visible">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/textoTotalAPagar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:autoSizeMaxTextSize="18sp"
                android:autoSizeMinTextSize="12sp"
                android:autoSizeStepGranularity="1sp"
                android:autoSizeTextType="uniform"
                android:breakStrategy="simple"
                android:ellipsize="end"
                android:fontFamily="@font/plus_jakarta_sans_extrabold"
                android:fontFeatureSettings="tnum"
                android:hyphenationFrequency="none"
                android:maxLines="1"
                android:textColor="@color/marea_tx"
                android:textSize="17sp"
                tools:text="Total a pagar: S/ 96.00" />

            <TextView
                android:id="@+id/textoBarraPagadoSaldo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:autoSizeMaxTextSize="12.5sp"
                android:autoSizeMinTextSize="10sp"
                android:autoSizeStepGranularity="1sp"
                android:autoSizeTextType="uniform"
                android:fontFamily="@font/inter_semibold"
                android:fontFeatureSettings="tnum"
                android:maxLines="1"
                android:textColor="@color/marea_tx2"
                android:textSize="12sp"
                tools:text="Pagado S/ 0.00 · Saldo S/ 96.00" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnConfirmarCobro"
            style="@style/Boton.Primario"
            android:layout_width="wrap_content"
            android:layout_height="52dp"
            android:autoSizeMaxTextSize="15sp"
            android:autoSizeMinTextSize="11sp"
            android:autoSizeStepGranularity="1sp"
            android:autoSizeTextType="uniform"
            android:enabled="false"
            android:maxLines="1"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:text="@string/cobro_confirmar" />
    </LinearLayout>
</LinearLayout>
