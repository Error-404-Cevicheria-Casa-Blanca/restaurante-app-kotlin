<?xml version="1.0" encoding="utf-8"?>
<!--
    Dialogo de confirmacion para liberar una mesa (PRB-39).
    Diseno propio sobre MaterialAlertDialog: titulo teal, mensaje slate,
    boton positivo teal con esquinas de 8dp y boton negativo solo texto.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingHorizontal="@dimen/espacio_xl"
    android:paddingTop="@dimen/espacio_xl"
    android:paddingBottom="@dimen/espacio_l">

    <ImageView
        android:id="@+id/iconoDialogo"
        android:layout_width="@dimen/icono_xl"
        android:layout_height="@dimen/icono_xl"
        android:contentDescription="@string/dialogo_liberar_icono_cd"
        android:src="@drawable/ic_error_outline"
        app:tint="@color/primary" />

    <TextView
        android:id="@+id/tituloDialogo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/espacio_m"
        android:breakStrategy="simple"
        android:gravity="center"
        android:hyphenationFrequency="none"
        android:text="@string/dialogo_liberar_titulo"
        android:textColor="@color/primary"
        android:textSize="@dimen/texto_titulo_tarjeta"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/mensajeDialogo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/espacio_s"
        android:breakStrategy="simple"
        android:gravity="center"
        android:hyphenationFrequency="none"
        android:lineSpacingExtra="2dp"
        android:text="@string/dialogo_liberar_mensaje"
        android:textColor="@color/texto_principal"
        android:textSize="@dimen/texto_cuerpo" />

    <ProgressBar
        android:id="@+id/progresoLiberar"
        style="?android:attr/progressBarStyle"
        android:layout_width="@dimen/espacio_xxl"
        android:layout_height="@dimen/espacio_xxl"
        android:layout_marginTop="@dimen/espacio_l"
        android:contentDescription="@string/dialogo_liberar_progreso"
        android:indeterminate="true"
        android:indeterminateTint="@color/primary"
        android:visibility="gone"
        tools:visibility="visible" />

    <TextView
        android:id="@+id/textoProgreso"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/espacio_s"
        android:breakStrategy="simple"
        android:hyphenationFrequency="none"
        android:text="@string/dialogo_liberar_progreso"
        android:textColor="@color/texto_secundario"
        android:textSize="@dimen/texto_etiqueta"
        android:visibility="gone"
        tools:visibility="visible" />

    <LinearLayout
        android:id="@+id/grupoBotones"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/espacio_l"
        android:gravity="end|center_vertical"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCancelar"
            style="@style/Boton.DialogoCancelar"
            android:layout_width="wrap_content"
            android:text="@string/dialogo_liberar_cancelar" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLiberar"
            style="@style/Boton.DialogoLiberar"
            android:layout_width="wrap_content"
            android:layout_marginStart="@dimen/espacio_s"
            android:text="@string/dialogo_liberar_confirmar" />
    </LinearLayout>
</LinearLayout>
