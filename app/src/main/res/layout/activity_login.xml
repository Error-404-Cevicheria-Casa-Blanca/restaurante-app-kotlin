<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/marea_s1"
    tools:context=".ui.login.LoginActivity">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollLogin"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="vertical">

        <!-- HERO MAREA OCEANICA (siempre azul marino profundo) -->
        <FrameLayout
            android:id="@+id/heroLogin"
            android:layout_width="match_parent"
            android:layout_height="330dp"
            android:background="@drawable/bg_hero_login_movil">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:importantForAccessibility="no"
                android:scaleType="fitXY"
                android:src="@drawable/bg_hero_waves_movil" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingHorizontal="24dp"
                android:paddingTop="28dp"
                android:paddingBottom="56dp">

                <FrameLayout
                    android:layout_width="@dimen/logo_movil"
                    android:layout_height="@dimen/logo_movil"
                    android:background="@drawable/bg_logo_hero_ring"
                    android:elevation="12dp"
                    android:padding="5dp">

                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/logoLogin"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@color/white"
                        android:contentDescription="@string/marca_descripcion_logo"
                        android:scaleType="centerCrop"
                        android:src="@drawable/logo_casa_blanca"
                        app:shapeAppearanceOverlay="@style/ShapeAppearance.Marea.Circulo" />
                </FrameLayout>

                <TextView
                    style="@style/Texto.Marca"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="@string/marca_nombre" />

                <TextView
                    style="@style/Texto.LemaMarca"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center"
                    android:text="@string/marca_lema"
                    android:textSize="15sp" />
            </LinearLayout>
        </FrameLayout>

        <!-- HOJA DE INICIO DE SESION (-30dp sobre el hero) -->
        <LinearLayout
            android:id="@+id/sheetLogin"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="-30dp"
            android:layout_weight="1"
            android:background="@drawable/bg_login_sheet_movil"
            android:elevation="12dp"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingTop="28dp"
            android:paddingBottom="20dp">

            <TextView
                style="@style/Texto.TituloPantalla"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/login_titulo"
                android:textSize="26sp" />

            <TextView
                style="@style/Texto.Secundario"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/login_subtitulo"
                android:textSize="15sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:layout_marginBottom="8dp"
                android:fontFamily="@font/inter_semibold"
                android:text="@string/login_usuario"
                android:textColor="@color/marea_tx2"
                android:textSize="13sp" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/inputUsuario"
                style="@style/Campo.Marea"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:hintEnabled="false"
                app:startIconContentDescription="@string/login_usuario"
                app:startIconDrawable="@drawable/ic_person"
                app:startIconTint="@color/marea_tx3">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/entradaUsuario"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/alto_campo_login"
                    android:fontFamily="@font/inter_medium"
                    android:hint="@string/login_usuario"
                    android:imeOptions="actionNext"
                    android:inputType="textPersonName"
                    android:maxLines="1"
                    android:textColor="@color/marea_tx"
                    android:textColorHint="@color/marea_tx3"
                    android:textSize="16sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="8dp"
                android:fontFamily="@font/inter_semibold"
                android:text="@string/login_clave"
                android:textColor="@color/marea_tx2"
                android:textSize="13sp" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/inputClave"
                style="@style/Campo.Marea"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:endIconContentDescription="@string/login_mostrar_clave"
                app:endIconDrawable="@drawable/ic_visibility"
                app:endIconMode="custom"
                app:endIconTint="@color/marea_tx2"
                app:hintEnabled="false"
                app:startIconContentDescription="@string/login_clave"
                app:startIconDrawable="@drawable/ic_lock"
                app:startIconTint="@color/marea_tx3">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/entradaClave"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/alto_campo_login"
                    android:fontFamily="@font/inter_medium"
                    android:hint="@string/login_clave"
                    android:imeOptions="actionDone"
                    android:inputType="textPassword"
                    android:maxLines="1"
                    android:textColor="@color/marea_tx"
                    android:textColorHint="@color/marea_tx3"
                    android:textSize="16sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:id="@+id/textoError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:accessibilityLiveRegion="polite"
                android:background="@drawable/bg_error_banner"
                android:drawablePadding="10dp"
                android:fontFamily="@font/inter_semibold"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp"
                android:paddingVertical="12dp"
                android:textColor="@color/marea_banner_err_fg"
                android:textSize="14sp"
                android:visibility="gone"
                app:drawableStartCompat="@drawable/ic_alert_triangle"
                app:drawableTint="@color/marea_banner_err_fg"
                tools:text="@string/login_error_credenciales"
                tools:visibility="visible" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnIngresar"
                style="@style/Boton.Primario"
                android:layout_width="match_parent"
                android:layout_marginTop="18dp"
                android:text="@string/login_ingresar"
                app:icon="@drawable/ic_arrow_forward"
                app:iconGravity="textEnd" />

            <ProgressBar
                android:id="@+id/progresoLogin"
                android:layout_width="@dimen/icono_grande"
                android:layout_height="@dimen/icono_grande"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="10dp"
                android:indeterminate="true"
                android:indeterminateTint="@color/marea_cyh"
                android:visibility="gone"
                tools:visibility="visible" />

            <TextView
                android:id="@+id/avisoDemo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_banner_demo"
                android:drawablePadding="10dp"
                android:fontFamily="@font/inter_semibold"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp"
                android:paddingVertical="12dp"
                android:text="@string/login_modo_demo"
                android:textColor="@color/marea_banner_demo_fg"
                android:textSize="13sp"
                android:visibility="gone"
                app:drawableStartCompat="@drawable/ic_info_circle"
                app:drawableTint="@color/marea_banner_demo_fg"
                tools:visibility="visible" />

            <Space
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/versionApp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="@font/inter"
                android:gravity="center"
                android:textColor="@color/marea_tx3"
                android:textSize="12.5sp"
                tools:text="Versión 1.0 · Cevichería Restaurante" />
        </LinearLayout>
    </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</FrameLayout>
