<?xml version="1.0" encoding="utf-8"?>
<!--
    Login movil (Stitch: m_vil_login_mesero/code.html).
    Hero teal con logo + tarjeta blanca de 24dp con pestanas Credenciales / PIN Rapido.
-->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fillViewport="true"
    tools:context=".ui.login.LoginActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="vertical">

        <!-- HERO DE MARCA -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_hero_login_movil"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/espacio_xl"
            android:paddingTop="@dimen/espacio_xl"
            android:paddingBottom="@dimen/espacio_xxl">

            <FrameLayout
                android:layout_width="112dp"
                android:layout_height="112dp"
                android:background="@drawable/bg_circulo_logo"
                android:padding="@dimen/espacio_m">

                <ImageView
                    android:id="@+id/logoLogin"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@string/marca_descripcion_logo"
                    android:scaleType="fitCenter"
                    android:src="@drawable/logo_casa_blanca" />
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espacio_m"
                android:breakStrategy="simple"
                android:hyphenationFrequency="none"
                android:text="@string/marca_nombre"
                style="@style/Texto.Marca" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:breakStrategy="simple"
                android:hyphenationFrequency="none"
                android:letterSpacing="0.12"
                android:text="@string/marca_cevicheria"
                android:textAllCaps="true"
                android:textColor="@color/primary_fixed_dim"
                android:textSize="@dimen/texto_etiqueta"
                android:textStyle="bold" />

            <View
                android:layout_width="48dp"
                android:layout_height="4dp"
                android:layout_marginTop="@dimen/espacio_s"
                android:background="@drawable/bg_pill_lima" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espacio_s"
                android:breakStrategy="simple"
                android:gravity="center"
                android:hyphenationFrequency="none"
                android:text="@string/marca_lema"
                style="@style/Texto.LemaMarca" />
        </LinearLayout>

        <!-- TARJETA DE AUTENTICACION -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Tarjeta.Login"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="-24dp"
            android:layout_marginHorizontal="@dimen/espacio_l"
            app:cardCornerRadius="@dimen/radio_tarjeta_login"
            app:cardElevation="@dimen/elevacion_tarjeta_login">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/espacio_xl">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:breakStrategy="simple"
                    android:hyphenationFrequency="none"
                    android:text="@string/login_titulo"
                    android:textColor="@color/on_surface"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/espacio_xs"
                    android:breakStrategy="simple"
                    android:hyphenationFrequency="none"
                    android:text="@string/login_subtitulo"
                    android:textColor="@color/on_surface_variant"
                    android:textSize="@dimen/texto_secundario" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Usuario -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/inputUsuario"
                        style="@style/Widget.Material3.TextInputLayout.FilledBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/espacio_l"
                        android:hint="@string/login_usuario"
                        app:boxBackgroundColor="@color/login_campo_relleno"
                        app:boxCornerRadiusBottomEnd="@dimen/espacio_l"
                        app:boxCornerRadiusBottomStart="@dimen/espacio_l"
                        app:boxCornerRadiusTopEnd="@dimen/espacio_l"
                        app:boxCornerRadiusTopStart="@dimen/espacio_l"
                        app:boxStrokeWidth="0dp"
                        app:boxStrokeWidthFocused="0dp"
                        app:startIconContentDescription="@string/login_usuario"
                        app:startIconDrawable="@drawable/ic_person"
                        app:startIconTint="@color/primary">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/entradaUsuario"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/alto_campo_login"
                            android:imeOptions="actionNext"
                            android:inputType="textPersonName"
                            android:maxLines="1"
                            android:textColor="@color/on_surface"
                            android:textSize="@dimen/texto_cuerpo" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Contrasena con boton de ver -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/inputClave"
                        style="@style/Widget.Material3.TextInputLayout.FilledBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/espacio_m"
                        android:hint="@string/login_clave"
                        app:boxBackgroundColor="@color/login_campo_relleno"
                        app:boxCornerRadiusBottomEnd="@dimen/espacio_l"
                        app:boxCornerRadiusBottomStart="@dimen/espacio_l"
                        app:boxCornerRadiusTopEnd="@dimen/espacio_l"
                        app:boxCornerRadiusTopStart="@dimen/espacio_l"
                        app:boxStrokeWidth="0dp"
                        app:boxStrokeWidthFocused="0dp"
                        app:endIconContentDescription="@string/login_mostrar_clave"
                        app:endIconDrawable="@drawable/ic_visibility"
                        app:endIconMode="custom"
                        app:endIconTint="@color/on_surface_variant"
                        app:startIconContentDescription="@string/login_clave"
                        app:startIconDrawable="@drawable/ic_lock"
                        app:startIconTint="@color/primary">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/entradaClave"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/alto_campo_login"
                            android:imeOptions="actionDone"
                            android:inputType="textPassword"
                            android:maxLines="1"
                            android:textColor="@color/on_surface"
                            android:textSize="@dimen/texto_cuerpo" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Banner de error (la Activity lo muestra/oculta) -->
                    <TextView
                        android:id="@+id/textoError"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/espacio_m"
                        android:accessibilityLiveRegion="polite"
                        android:background="@drawable/bg_error_banner"
                        android:breakStrategy="simple"
                        android:drawableStart="@drawable/ic_error_outline"
                        android:drawablePadding="@dimen/espacio_s"
                        android:drawableTint="@color/error"
                        android:hyphenationFrequency="none"
                        android:padding="@dimen/espacio_m"
                        android:textColor="@color/on_error_container"
                        android:textSize="@dimen/texto_secundario"
                        android:visibility="gone"
                        tools:text="@string/login_error_credenciales"
                        tools:visibility="visible" />

                    <!-- Boton principal 56dp / #0B5563 / radio 16dp -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnIngresar"
                        style="@style/Boton.Primario"
                        android:layout_width="match_parent"
                        android:layout_marginTop="@dimen/espacio_l"
                        android:text="@string/login_ingresar"
                        app:icon="@drawable/ic_arrow_forward"
                        app:iconGravity="textEnd" />

                    <ProgressBar
                        android:id="@+id/progresoLogin"
                        android:layout_width="@dimen/icono_grande"
                        android:layout_height="@dimen/icono_grande"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="@dimen/espacio_s"
                        android:indeterminate="true"
                        android:indeterminateTint="@color/primary"
                        android:visibility="gone"
                        tools:visibility="visible" />
                </LinearLayout>

                <TextView
                    android:id="@+id/avisoDemo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/espacio_l"
                    android:background="@drawable/bg_banner_demo"
                    android:breakStrategy="simple"
                    android:gravity="center"
                    android:hyphenationFrequency="none"
                    android:padding="@dimen/espacio_s"
                    android:text="@string/login_modo_demo"
                    android:textColor="@color/on_secondary_fixed"
                    android:textSize="@dimen/texto_etiqueta"
                    android:visibility="gone"
                    tools:visibility="visible" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/versionApp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/espacio_l"
            android:layout_marginBottom="@dimen/espacio_xl"
            android:textColor="@color/on_surface_variant"
            android:textSize="@dimen/texto_etiqueta"
            tools:text="Versión 1.0" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
