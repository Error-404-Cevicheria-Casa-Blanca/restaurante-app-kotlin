<?xml version="1.0" encoding="utf-8"?>
<!--
    Pedidos activos (PRB-88, Fase 6). Cabecera con titulo y Actualizar,
    chips Todos/Mesa/Para Llevar y lista con estados cargando/vacio/error.
    En tablet el RecyclerView usa 2 columnas (integer/columnas_pedidos).
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    tools:context=".ui.pedidos.PedidosFragment">

    <LinearLayout
        android:id="@+id/encabezadoPedidos"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/espacio_l"
        android:paddingTop="@dimen/espacio_m"
        android:paddingBottom="@dimen/espacio_s"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/textoTituloPedidos"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:autoSizeMaxTextSize="24sp"
            android:autoSizeMinTextSize="16sp"
            android:autoSizeStepGranularity="1sp"
            android:autoSizeTextType="uniform"
            android:breakStrategy="simple"
            android:hyphenationFrequency="none"
            android:maxLines="1"
            android:text="@string/pedidos_titulo"
            android:textColor="@color/texto_principal"
            android:textSize="@dimen/texto_titulo_pantalla"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnActualizarPedidos"
            style="@style/Boton.BarraAccion"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/toque_minimo"
            android:autoSizeMaxTextSize="14sp"
            android:autoSizeMinTextSize="10sp"
            android:autoSizeStepGranularity="1sp"
            android:autoSizeTextType="uniform"
            android:breakStrategy="simple"
            android:contentDescription="@string/cd_actualizar_pedidos"
            android:hyphenationFrequency="none"
            android:maxLines="1"
            android:paddingHorizontal="@dimen/espacio_m"
            android:text="@string/pedidos_actualizar"
            app:icon="@drawable/ic_refresh"
            app:iconGravity="textStart"
            app:iconPadding="@dimen/espacio_xs" />
    </LinearLayout>

    <HorizontalScrollView
        android:id="@+id/scrollChipsPedidos"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/espacio_l"
        android:paddingBottom="@dimen/espacio_s"
        android:scrollbars="none"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/encabezadoPedidos">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipsPedidos"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:chipSpacingHorizontal="@dimen/espacio_s"
            app:selectionRequired="true"
            app:singleLine="true"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/chipTodos"
                style="@style/Chip.FiltroPedido"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="@string/pedidos_filtro_todos" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipMesa"
                style="@style/Chip.FiltroPedido"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/pedidos_filtro_mesa" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipParaLlevar"
                style="@style/Chip.FiltroPedido"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/pedidos_filtro_para_llevar" />
        </com.google.android.material.chip.ChipGroup>
    </HorizontalScrollView>

    <FrameLayout
        android:id="@+id/contenedorPedidos"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/scrollChipsPedidos">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerPedidos"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:padding="@dimen/espacio_s"
            tools:itemCount="4"
            tools:listitem="@layout/item_pedido" />

        <ProgressBar
            android:id="@+id/progresoPedidos"
            android:layout_width="@dimen/toque_minimo"
            android:layout_height="@dimen/toque_minimo"
            android:layout_gravity="center"
            android:indeterminate="true"
            android:indeterminateTint="@color/primary"
            android:visibility="gone"
            tools:visibility="visible" />

        <LinearLayout
            android:id="@+id/grupoVacioPedidos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="@dimen/espacio_xl"
            android:visibility="gone"
            tools:visibility="visible">

            <ImageView
                android:layout_width="@dimen/icono_xl"
                android:layout_height="@dimen/icono_xl"
                android:contentDescription="@string/pedidos_vacio"
                android:src="@drawable/ic_inbox"
                app:tint="@color/on_surface_variant" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espacio_m"
                android:gravity="center"
                android:text="@string/pedidos_vacio"
                android:textColor="@color/on_surface"
                android:textSize="@dimen/texto_cuerpo"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espacio_xs"
                android:gravity="center"
                android:text="@string/pedidos_vacio_ayuda"
                android:textColor="@color/on_surface_variant"
                android:textSize="@dimen/texto_secundario" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/grupoErrorPedidos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="@dimen/espacio_xl"
            android:visibility="gone"
            tools:visibility="visible">

            <ImageView
                android:layout_width="@dimen/icono_xl"
                android:layout_height="@dimen/icono_xl"
                android:contentDescription="@string/pedidos_error"
                android:src="@drawable/ic_error_outline"
                app:tint="@color/error" />

            <TextView
                android:id="@+id/textoErrorPedidos"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espacio_m"
                android:gravity="center"
                android:text="@string/pedidos_error"
                android:textColor="@color/on_surface"
                android:textSize="@dimen/texto_cuerpo" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnReintentarPedidos"
                style="@style/Boton.Primario"
                android:layout_width="wrap_content"
                android:layout_marginTop="@dimen/espacio_l"
                android:paddingHorizontal="@dimen/espacio_xl"
                android:text="@string/accion_reintentar" />
        </LinearLayout>
    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
