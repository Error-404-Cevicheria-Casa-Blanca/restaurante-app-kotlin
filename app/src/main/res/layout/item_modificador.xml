<?xml version="1.0" encoding="utf-8"?>
<!--
    Fila de un modificador (PRB-92). Todo el renglon es tactil (48dp) y el
    precio extra se muestra a la derecha cuando el modificador lo tiene.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:minHeight="@dimen/toque_minimo"
    android:orientation="horizontal"
    android:paddingVertical="@dimen/espacio_xs">

    <com.google.android.material.checkbox.MaterialCheckBox
        android:id="@+id/checkModificador"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:autoSizeMaxTextSize="16sp"
        android:autoSizeMinTextSize="11sp"
        android:autoSizeStepGranularity="1sp"
        android:autoSizeTextType="uniform"
        android:breakStrategy="simple"
        android:ellipsize="none"
        android:hyphenationFrequency="none"
        android:minHeight="@dimen/toque_minimo"
        android:maxLines="2"
        android:textColor="@color/on_surface"
        android:textSize="@dimen/texto_cuerpo"
        tools:text="Extra queso" />

    <TextView
        android:id="@+id/textoPrecioModificador"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/espacio_s"
        android:autoSizeMaxTextSize="15sp"
        android:autoSizeMinTextSize="11sp"
        android:autoSizeStepGranularity="1sp"
        android:autoSizeTextType="uniform"
        android:breakStrategy="simple"
        android:hyphenationFrequency="none"
        android:maxLines="1"
        android:textColor="@color/stitch_primary"
        android:textSize="@dimen/texto_secundario"
        android:textStyle="bold"
        android:visibility="gone"
        tools:text="+ S/ 2.00"
        tools:visibility="visible" />
</LinearLayout>
