<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="@drawable/bg_opt_marea"
    android:gravity="center_vertical"
    android:minHeight="56dp"
    android:orientation="horizontal"
    android:paddingHorizontal="12dp"
    android:paddingVertical="6dp">

    <com.google.android.material.checkbox.MaterialCheckBox
        android:id="@+id/checkModificador"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:autoSizeMaxTextSize="16sp"
        android:autoSizeMinTextSize="12sp"
        android:autoSizeStepGranularity="1sp"
        android:autoSizeTextType="uniform"
        android:breakStrategy="simple"
        android:ellipsize="none"
        android:fontFamily="@font/inter"
        android:hyphenationFrequency="none"
        android:maxLines="2"
        android:minHeight="@dimen/toque_minimo"
        android:paddingStart="6dp"
        android:textColor="@color/marea_tx"
        android:textSize="15sp"
        android:textStyle="bold"
        app:buttonTint="@color/selector_chk_marea"
        tools:text="Extra queso" />

    <TextView
        android:id="@+id/textoPrecioModificador"
        style="@style/Texto.NumeroTabular"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/espacio_s"
        android:autoSizeMaxTextSize="15sp"
        android:autoSizeMinTextSize="11sp"
        android:autoSizeStepGranularity="1sp"
        android:autoSizeTextType="uniform"
        android:breakStrategy="simple"
        android:hyphenationFrequency="none"
        android:maxLines="1"
        android:textColor="@color/marea_cyh"
        android:textSize="15sp"
        android:textStyle="bold"
        android:visibility="gone"
        tools:text="+ S/ 2.00"
        tools:visibility="visible" />
</LinearLayout>
