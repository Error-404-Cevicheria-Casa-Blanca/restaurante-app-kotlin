<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="@drawable/bg_opt_marea"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:minHeight="60dp"
    android:orientation="horizontal"
    android:paddingHorizontal="12dp"
    android:paddingVertical="8dp">

    <com.google.android.material.checkbox.MaterialCheckBox
        android:id="@+id/checkPlatoDivision"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:clickable="false"
        android:focusable="false"
        android:importantForAccessibility="no"
        app:buttonTint="@color/selector_chk_marea" />

    <TextView
        android:id="@+id/textoPlatoDivision"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:layout_weight="1"
        android:autoSizeMaxTextSize="15sp"
        android:autoSizeMinTextSize="12sp"
        android:autoSizeStepGranularity="1sp"
        android:autoSizeTextType="uniform"
        android:breakStrategy="simple"
        android:fontFamily="@font/inter"
        android:hyphenationFrequency="none"
        android:maxLines="2"
        android:textColor="@color/marea_tx"
        android:textSize="14.5sp"
        android:textStyle="bold"
        tools:text="Tiradito al Ají Amarillo" />

    <TextView
        android:id="@+id/textoCantidadDivision"
        style="@style/Texto.NumeroTabular"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:breakStrategy="simple"
        android:hyphenationFrequency="none"
        android:maxLines="1"
        android:textColor="@color/marea_tx2"
        android:textSize="13sp"
        tools:text="x2" />

    <TextView
        android:id="@+id/textoSubtotalDivision"
        style="@style/Texto.NumeroTabular"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:autoSizeMaxTextSize="15sp"
        android:autoSizeMinTextSize="12sp"
        android:autoSizeStepGranularity="1sp"
        android:autoSizeTextType="uniform"
        android:breakStrategy="simple"
        android:hyphenationFrequency="none"
        android:maxLines="1"
        android:textColor="@color/marea_tx"
        android:textSize="15sp"
        android:textStyle="bold"
        tools:text="S/ 92.00" />
</LinearLayout>
