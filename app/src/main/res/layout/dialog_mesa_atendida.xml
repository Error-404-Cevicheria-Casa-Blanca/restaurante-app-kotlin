<?xml version="1.0" encoding="utf-8"?>
<!--
    Mesa ATENDIDA (azul) sin pedido enviado (PRB-83): el mesero puede retomar
    la comanda editable o liberar la mesa con confirmacion. Sigue el lenguaje
    visual de los dialogos de marca: icono teal, titulo teal y botones de 8dp.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingHorizontal="@dimen/espacio_xl"
    android:paddingTop="@dimen/espacio_xl"
    android:paddingBottom="@dimen/espacio_l">

    <ImageView
        android:id="@+id/iconoMesaAtendida"
        android:layout_width="@dimen/icono_xl"
        android:layout_height="@dimen/icono_xl"
        android:contentDescription="@string/dialogo_atendida_icono_cd"
        android:src="@drawable/ic_restaurant"
        app:tint="@color/primary" />

    <TextView
        android:id="@+id/tituloMesaAtendida"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/espacio_m"
        android:autoSizeMaxTextSize="20sp"
        android:autoSizeMinTextSize="14sp"
        android:autoSizeStepGranularity="1sp"
        android:autoSizeTextType="uniform"
        android:breakStrategy="simple"
        android:gravity="center"
        android:hyphenationFrequency="none"
        android:maxLines="2"
        android:text="@string/dialogo_atendida_titulo"
        android:textColor="@color/primary"
        android:textSize="@dimen/texto_titulo_tarjeta"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/mensajeMesaAtendida"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/espacio_s"
        android:autoSizeMaxTextSize="16sp"
        android:autoSizeMinTextSize="11sp"
        android:autoSizeStepGranularity="1sp"
        android:autoSizeTextType="uniform"
        android:breakStrategy="simple"
        android:gravity="center"
        android:hyphenationFrequency="none"
        android:lineSpacingExtra="2dp"
        android:maxLines="4"
        android:text="@string/dialogo_atendida_mensaje"
        android:textColor="@color/texto_principal"
        android:textSize="@dimen/texto_cuerpo" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnRetomarComanda"
        style="@style/Boton.DialogoLiberar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/toque_minimo"
        android:layout_marginTop="@dimen/espacio_l"
        android:autoSizeMaxTextSize="16sp"
        android:autoSizeMinTextSize="11sp"
        android:autoSizeStepGranularity="1sp"
        android:autoSizeTextType="uniform"
        android:breakStrategy="simple"
        android:hyphenationFrequency="none"
        android:maxLines="1"
        android:text="@string/dialogo_atendida_retomar"
        app:icon="@drawable/ic_edit"
        app:iconGravity="textStart"
        app:iconPadding="@dimen/espacio_s" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnLiberarMesaAtendida"
        style="@style/Boton.Outlined"
        android:layout_width="match_parent"
        android:layout_height="@dimen/toque_minimo"
        android:layout_marginTop="@dimen/espacio_s"
        android:autoSizeMaxTextSize="16sp"
        android:autoSizeMinTextSize="11sp"
        android:autoSizeStepGranularity="1sp"
        android:autoSizeTextType="uniform"
        android:breakStrategy="simple"
        android:hyphenationFrequency="none"
        android:maxLines="1"
        android:text="@string/dialogo_atendida_liberar"
        android:textColor="@color/error"
        app:strokeColor="@color/error" />
</LinearLayout>
