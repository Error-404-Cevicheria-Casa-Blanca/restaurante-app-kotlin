<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialogo_premium"
    android:orientation="vertical"
    android:paddingStart="22dp"
    android:paddingTop="28dp"
    android:paddingEnd="22dp"
    android:paddingBottom="22dp">

    <FrameLayout
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/bg_ib_aten">

        <ImageView
            android:id="@+id/iconoMesaAtendida"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center"
            android:contentDescription="@null"
            android:src="@drawable/ic_marea_aten"
            app:tint="@color/sem_aten_c" />
    </FrameLayout>

    <TextView
        android:id="@+id/tituloMesaAtendida"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="center"
        android:text="@string/dialogo_atendida_titulo"
        android:textAppearance="@style/Texto.TituloPantalla"
        android:textColor="@color/marea_tx"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/mensajeMesaAtendida"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:lineSpacingExtra="2dp"
        android:text="@string/dialogo_atendida_mensaje"
        android:textColor="@color/marea_tx2"
        android:textSize="13sp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnLiberarMesaAtendida"
        style="@style/Boton.PeligroSutil"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:text="@string/dialogo_atendida_liberar" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnRetomarComanda"
        style="@style/Boton.Primario"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="@string/dialogo_atendida_retomar"
        app:icon="@drawable/ic_edit"
        app:iconGravity="textStart" />

</LinearLayout>
