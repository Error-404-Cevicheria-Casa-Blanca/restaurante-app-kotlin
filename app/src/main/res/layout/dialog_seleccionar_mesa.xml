<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialogo_premium"
    android:orientation="vertical"
    android:paddingStart="22dp"
    android:paddingTop="26dp"
    android:paddingEnd="22dp"
    android:paddingBottom="22dp">

    <FrameLayout
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/bg_ib_info">

        <ImageView
            android:id="@+id/iconoSeleccionMesa"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center"
            android:contentDescription="@null"
            android:src="@drawable/ic_swap_horiz"
            app:tint="@color/sem_info_c" />
    </FrameLayout>

    <TextView
        android:id="@+id/tituloSeleccionMesa"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="center"
        android:textAppearance="@style/Texto.TituloPantalla"
        android:textColor="@color/marea_tx"
        android:textSize="18sp"
        android:textStyle="bold"
        tools:text="Transferir mesa" />

    <TextView
        android:id="@+id/mensajeSeleccionMesa"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:lineSpacingExtra="2dp"
        android:textColor="@color/marea_tx2"
        android:textSize="13sp"
        tools:text="Selecciona la mesa libre de destino." />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/listaDestinos"
        android:layout_width="match_parent"
        android:layout_height="@dimen/alto_lista_destinos"
        android:layout_marginTop="14dp"
        android:clipToPadding="false"
        android:overScrollMode="never"
        tools:listitem="@layout/item_mesa_destino" />

    <LinearLayout
        android:id="@+id/grupoProgreso"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="16dp"
        android:visibility="gone">

        <ProgressBar
            android:id="@+id/progresoAccion"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:indeterminateTint="@color/marea_cy" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/grupoBotones"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnConfirmarDestino"
            style="@style/Boton.Primario"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:enabled="false"
            android:maxLines="1"
            android:text="@string/destino_confirmar" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCancelarDestino"
            style="@style/Boton.Outlined"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/destino_cancelar" />
    </LinearLayout>

</LinearLayout>
