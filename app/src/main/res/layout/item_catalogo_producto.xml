<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardProducto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardBackgroundColor="@color/marea_s1"
    app:cardCornerRadius="20dp"
    app:cardElevation="0dp"
    app:cardPreventCornerOverlap="false"
    app:strokeColor="@color/marea_line"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="136dp"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/imagenProducto"
            android:layout_width="104dp"
            android:layout_height="136dp"
            android:background="@drawable/bg_placeholder_plato"
            android:contentDescription="@null"
            android:scaleType="centerInside"
            android:src="@drawable/ic_restaurant_placeholder" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minHeight="136dp"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingTop="10dp"
            android:paddingEnd="12dp"
            android:paddingBottom="10dp">

            <TextView
                android:id="@+id/textoNombreProducto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:breakStrategy="simple"
                android:ellipsize="end"
                android:fontFamily="@font/plus_jakarta_sans_extrabold"
                android:hyphenationFrequency="none"
                android:includeFontPadding="false"
                android:lineSpacingMultiplier="1.15"
                android:maxLines="2"
                android:textColor="@color/marea_tx"
                android:textSize="16.5sp"
                tools:text="Ceviche Clásico La Casa Blanca" />

            <TextView
                android:id="@+id/textoDescripcionProducto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:breakStrategy="simple"
                android:ellipsize="end"
                android:fontFamily="@font/inter"
                android:hyphenationFrequency="none"
                android:lineSpacingMultiplier="1.2"
                android:maxLines="2"
                android:textColor="@color/marea_tx2"
                android:textSize="13sp"
                tools:text="Pescado del día, camote glaseado y choclo tierno." />

            <TextView
                android:id="@+id/textoNoDisponible"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_pill_no_disponible"
                android:fontFamily="@font/inter_bold"
                android:paddingStart="10dp"
                android:paddingTop="3dp"
                android:paddingEnd="10dp"
                android:paddingBottom="3dp"
                android:text="@string/comanda_no_disponible"
                android:textColor="@color/on_error_container"
                android:textSize="11.5sp"
                android:visibility="gone" />

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/textoPrecioProducto"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:fontFamily="@font/plus_jakarta_sans_extrabold"
                    android:fontFeatureSettings="tnum"
                    android:includeFontPadding="false"
                    android:textColor="@color/marea_tx"
                    android:textSize="17sp"
                    tools:text="S/ 48.00" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/botonAgregar"
                    style="@style/Boton.PrimarioMediano"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:minWidth="0dp"
                    android:minHeight="48dp"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:text="@string/comanda_agregar"
                    android:textSize="15sp"
                    app:cornerRadius="@dimen/radio_boton"
                    app:icon="@drawable/ic_marea_plus"
                    app:iconPadding="6dp"
                    app:iconSize="16dp"
                    app:iconTint="@color/selector_texto_boton_primario" />

                <LinearLayout
                    android:id="@+id/grupoCantidad"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_qty_marea"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="2dp"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <ImageButton
                        android:id="@+id/btnDisminuirPlato"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_qty_minus_marea"
                        android:contentDescription="@null"
                        android:padding="12dp"
                        android:scaleType="centerInside"
                        android:src="@drawable/ic_marea_minus"
                        app:tint="@color/marea_tx" />

                    <TextView
                        android:id="@+id/textoCantidadPlato"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/plus_jakarta_sans_extrabold"
                        android:fontFeatureSettings="tnum"
                        android:gravity="center"
                        android:minWidth="28dp"
                        android:paddingStart="2dp"
                        android:paddingEnd="2dp"
                        android:textColor="@color/marea_tx"
                        android:textSize="16sp"
                        tools:text="2" />

                    <ImageButton
                        android:id="@+id/btnAumentarPlato"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_qty_plus_marea"
                        android:contentDescription="@null"
                        android:padding="12dp"
                        android:scaleType="centerInside"
                        android:src="@drawable/ic_marea_plus"
                        app:tint="@color/marea_oncy" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
