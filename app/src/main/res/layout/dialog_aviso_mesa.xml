<?xml version="1.0" encoding="utf-8"?>
<!-- Aviso de mesa con el lenguaje visual de la app: icono, titulo teal y boton de marca. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingHorizontal="@dimen/espacio_xl"
    android:paddingTop="@dimen/espacio_xl"
    android:paddingBottom="@dimen/espacio_l">

    <ImageView
        android:id="@+id/iconoAviso"
        android:layout_width="@dimen/icono_xl"
        android:layout_height="@dimen/icono_xl"
        android:contentDescription="@string/aviso_mesa_icono_cd"
        android:src="@drawable/ic_error_outline"
        app:tint="@color/primary" />

    <TextView
        android:id="@+id/tituloAviso"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/espacio_m"
        android:autoSizeMaxTextSize="20sp"
        android:autoSizeMinTextSize="14sp"
        android:autoSizeStepGranularity="1sp"
        android:autoSizeTextType="uniform"
        android:breakStrategy="simple"
        android:gravity="center"
        android:hyphenationFrequency="none"
        android:maxLines="2"
        android:textColor="@color/primary"
        android:textSize="@dimen/texto_titulo_tarjeta"
        android:textStyle="bold"
        tools:text="Mesa 5" />

    <TextView
        android:id="@+id/mensajeAviso"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/espacio_s"
        android:autoSizeMaxTextSize="16sp"
        android:autoSizeMinTextSize="11sp"
        android:autoSizeStepGranularity="1sp"
        android:autoSizeTextType="uniform"
        android:breakStrategy="simple"
        android:gravity="center"
        android:hyphenationFrequency="none"
        android:lineSpacingExtra="2dp"
        android:maxLines="4"
        android:textColor="@color/texto_principal"
        android:textSize="@dimen/texto_cuerpo"
        tools:text="La mesa 5 pidió la cuenta. Acércate a cobrar antes de abrir otra comanda." />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnEntendido"
        style="@style/Boton.DialogoLiberar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/toque_minimo"
        android:layout_marginTop="@dimen/espacio_l"
        android:autoSizeMaxTextSize="16sp"
        android:autoSizeMinTextSize="11sp"
        android:autoSizeStepGranularity="1sp"
        android:autoSizeTextType="uniform"
        android:breakStrategy="simple"
        android:hyphenationFrequency="none"
        android:maxLines="1"
        android:text="@string/accion_entendido" />
</LinearLayout>
