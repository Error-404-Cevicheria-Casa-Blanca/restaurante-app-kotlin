<?xml version="1.0" encoding="utf-8"?>
<!--
    Selector de modificadores por plato (PRB-92). Dialogo premium con la
    paleta de la skill diseno-cevicheria: fondo blanco, esquinas de 16dp,
    titulo teal, precios en teal y botones simetricos de 8dp.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialogo_premium"
    android:orientation="vertical"
    android:paddingHorizontal="@dimen/espacio_xl"
    android:paddingTop="@dimen/espacio_xl"
    android:paddingBottom="@dimen/espacio_l">

    <ImageView
        android:id="@+id/iconoModificadores"
        android:layout_width="@dimen/icono_xl"
        android:layout_height="@dimen/icono_xl"
        android:layout_gravity="center_horizontal"
        android:contentDescription="@string/modificadores_icono_cd"
        android:src="@drawable/ic_restaurant"
        app:tint="@color/primary" />

    <TextView
        android:id="@+id/textoTituloModificadores"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/espacio_m"
        android:autoSizeMaxTextSize="22sp"
        android:autoSizeMinTextSize="15sp"
        android:autoSizeStepGranularity="1sp"
        android:autoSizeTextType="uniform"
        android:breakStrategy="simple"
        android:ellipsize="none"
        android:gravity="center"
        android:hyphenationFrequency="none"
        android:maxLines="2"
        android:text="@string/modificadores_titulo"
        android:textColor="@color/primary"
        android:textSize="@dimen/texto_titulo_tarjeta"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/textoPlatoModificadores"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="@dimen/espacio_m"
        android:autoSizeMaxTextSize="17sp"
        android:autoSizeMinTextSize="12sp"
        android:autoSizeStepGranularity="1sp"
        android:autoSizeTextType="uniform"
        android:background="@drawable/bg_pill_superficie"
        android:breakStrategy="simple"
        android:ellipsize="none"
        android:gravity="center"
        android:hyphenationFrequency="none"
        android:maxLines="2"
        android:paddingHorizontal="@dimen/espacio_l"
        android:paddingVertical="@dimen/espacio_s"
        android:textColor="@color/stitch_primary"
        android:textSize="@dimen/texto_cuerpo"
        android:textStyle="bold"
        tools:text="Ceviche Clásico La Casa Blanca" />

    <TextView
        android:id="@+id/textoSubtituloModificadores"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/espacio_s"
        android:autoSizeMaxTextSize="14sp"
        android:autoSizeMinTextSize="11sp"
        android:autoSizeStepGranularity="1sp"
        android:autoSizeTextType="uniform"
        android:breakStrategy="simple"
        android:ellipsize="none"
        android:gravity="center"
        android:hyphenationFrequency="none"
        android:maxLines="3"
        android:text="@string/modificadores_subtitulo"
        android:textColor="@color/on_surface_variant"
        android:textSize="@dimen/texto_secundario" />

    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/borde_tarjeta"
        android:layout_marginTop="@dimen/espacio_l"
        android:background="@color/surface_variant" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollModificadores"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/listaModificadores"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingVertical="@dimen/espacio_s" />
    </androidx.core.widget.NestedScrollView>

    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/borde_tarjeta"
        android:background="@color/surface_variant" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/espacio_l"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:autoSizeMaxTextSize="16sp"
            android:autoSizeMinTextSize="11sp"
            android:autoSizeStepGranularity="1sp"
            android:autoSizeTextType="uniform"
            android:breakStrategy="simple"
            android:hyphenationFrequency="none"
            android:maxLines="2"
            android:text="@string/modificadores_total"
            android:textColor="@color/on_surface"
            android:textSize="@dimen/texto_cuerpo"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/textoTotalModificadores"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/espacio_s"
            android:autoSizeMaxTextSize="22sp"
            android:autoSizeMinTextSize="14sp"
            android:autoSizeStepGranularity="1sp"
            android:autoSizeTextType="uniform"
            android:breakStrategy="simple"
            android:hyphenationFrequency="none"
            android:maxLines="1"
            android:text="@string/comanda_monto_cero"
            android:textColor="@color/stitch_primary"
            android:textSize="@dimen/texto_titulo_tarjeta"
            android:textStyle="bold"
            tools:text="S/ 50.00" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/espacio_l"
        android:baselineAligned="false"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCancelarModificadores"
            style="@style/Boton.Outlined"
            android:layout_width="0dp"
            android:layout_height="@dimen/toque_minimo"
            android:layout_weight="1"
            android:autoSizeMaxTextSize="16sp"
            android:autoSizeMinTextSize="10sp"
            android:autoSizeStepGranularity="1sp"
            android:autoSizeTextType="uniform"
            android:breakStrategy="simple"
            android:hyphenationFrequency="none"
            android:maxLines="1"
            android:text="@string/modificadores_cancelar" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAgregarModificadores"
            style="@style/Boton.Primario"
            android:layout_width="0dp"
            android:layout_height="@dimen/toque_minimo"
            android:layout_marginStart="@dimen/espacio_s"
            android:layout_weight="1"
            android:autoSizeMaxTextSize="16sp"
            android:autoSizeMinTextSize="10sp"
            android:autoSizeStepGranularity="1sp"
            android:autoSizeTextType="uniform"
            android:breakStrategy="simple"
            android:hyphenationFrequency="none"
            android:maxLines="1"
            android:text="@string/modificadores_agregar"
            app:icon="@drawable/ic_add"
            app:iconGravity="textStart"
            app:iconPadding="@dimen/espacio_xs"
            app:iconTint="@color/on_primary" />
    </LinearLayout>
</LinearLayout>
