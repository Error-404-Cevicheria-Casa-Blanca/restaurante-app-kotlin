<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardMesa"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="6dp"
    android:clickable="true"
    android:focusable="true"
    android:minHeight="182dp"
    app:cardBackgroundColor="@color/transparent"
    app:cardCornerRadius="20dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/mesa_libre_cb"
    app:strokeWidth="1dp">

    <LinearLayout
        android:id="@+id/contenidoMesa"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:minHeight="182dp"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- Mantiene el texto compuesto "Mesa N" accesible para pruebas de navegacion Espresso -->
        <TextView
            android:id="@+id/textoMesa"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:importantForAccessibility="no"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="top"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/textoEtiquetaMesa"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter"
                    android:includeFontPadding="false"
                    android:text="@string/mesa_solo_etiqueta"
                    android:textColor="@color/marea_tx2"
                    android:textFontWeight="500"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/textoNumeroMesa"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:autoSizeMaxTextSize="34sp"
                    android:autoSizeMinTextSize="26sp"
                    android:autoSizeStepGranularity="1sp"
                    android:autoSizeTextType="uniform"
                    android:fontFamily="@font/lora"
                    android:fontFeatureSettings="tnum"
                    android:includeFontPadding="false"
                    android:lineSpacingExtra="0dp"
                    android:maxLines="1"
                    android:textColor="@color/marea_tx"
                    android:textFontWeight="700"
                    android:textSize="34sp"
                    android:textStyle="bold"
                    tools:text="1" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_marginEnd="3dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_people"
                    app:tint="@color/marea_tx2" />

                <TextView
                    android:id="@+id/textoCapacidad"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter"
                    android:includeFontPadding="false"
                    android:textColor="@color/marea_tx2"
                    android:textFontWeight="600"
                    android:textSize="13sp"
                    tools:text="4" />

                <ImageButton
                    android:id="@+id/btnAccionesMesa"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_marginEnd="-6dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@null"
                    android:padding="6dp"
                    android:src="@drawable/ic_more_vert"
                    app:tint="@color/marea_tx2" />
            </LinearLayout>
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:paddingVertical="4dp">

            <com.lacasablanca.mesero.ui.common.MesaCroquisView
                android:id="@+id/croquisMesa"
                android:layout_width="wrap_content"
                android:layout_height="72dp"
                android:layout_gravity="center" />
        </FrameLayout>

        <LinearLayout
            android:id="@+id/ribbonEstado"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginEnd="-12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="9dp"
            android:paddingEnd="21dp">

            <ImageView
                android:id="@+id/iconoEstado"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_marginEnd="5dp"
                android:importantForAccessibility="no"
                tools:src="@drawable/ic_marea_libre" />

            <TextView
                android:id="@+id/textoEstado"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="@font/inter"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textFontWeight="700"
                android:textSize="12sp"
                tools:text="Libre" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
