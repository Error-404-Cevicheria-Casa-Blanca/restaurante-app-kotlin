<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/espacio_xl"
    android:paddingTop="@dimen/espacio_s"
    android:paddingEnd="@dimen/espacio_xl"
    android:paddingBottom="@dimen/espacio_l">

    <TextView
        android:id="@+id/textoMensajeDivision"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:autoSizeMaxTextSize="16sp"
        android:autoSizeMinTextSize="11sp"
        android:autoSizeStepGranularity="1sp"
        android:autoSizeTextType="uniform"
        android:breakStrategy="simple"
        android:hyphenationFrequency="none"
        android:maxLines="3"
        android:text="@string/cobro_dividir_dialogo_mensaje"
        android:textColor="@color/on_surface_variant"
        android:textSize="@dimen/texto_secundario" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/campoComensales"
        style="@style/Campo.Cobro"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/espacio_l"
        android:hint="@string/cobro_dividir_comensales">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/textoComensales"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:imeOptions="actionDone"
            android:inputType="number"
            android:maxLength="2"
            android:maxLines="1" />
    </com.google.android.material.textfield.TextInputLayout>
</LinearLayout>
