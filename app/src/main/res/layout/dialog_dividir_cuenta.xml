<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialogo_premium"
    android:padding="@dimen/espacio_xl">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <FrameLayout
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:background="@drawable/bg_circulo_vacio">

            <ImageView
                android:layout_width="@dimen/icono_grande"
                android:layout_height="@dimen/icono_grande"
                android:layout_gravity="center"
                android:contentDescription="@string/cd_dividir_cuenta_icono"
                android:src="@drawable/ic_people"
                app:tint="@color/primary" />
        </FrameLayout>

        <TextView
            android:id="@+id/tituloDivision"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espacio_m"
            android:autoSizeMaxTextSize="22sp"
            android:autoSizeMinTextSize="15sp"
            android:autoSizeStepGranularity="1sp"
            android:autoSizeTextType="uniform"
            android:breakStrategy="simple"
            android:gravity="center"
            android:hyphenationFrequency="none"
            android:maxLines="2"
            android:text="@string/cobro_dividir_titulo"
            android:textColor="@color/primary"
            android:textSize="@dimen/texto_titulo_tarjeta"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/textoMensajeDivision"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espacio_s"
            android:autoSizeMaxTextSize="16sp"
            android:autoSizeMinTextSize="11sp"
            android:autoSizeStepGranularity="1sp"
            android:autoSizeTextType="uniform"
            android:breakStrategy="simple"
            android:gravity="center"
            android:hyphenationFrequency="none"
            android:lineSpacingExtra="2dp"
            android:maxLines="4"
            android:text="@string/cobro_dividir_dialogo_mensaje"
            android:textColor="@color/texto_principal"
            android:textSize="@dimen/texto_cuerpo" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/campoComensales"
            style="@style/Campo.Cobro"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espacio_xl"
            android:hint="@string/cobro_dividir_comensales">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/textoComensales"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:imeOptions="actionDone"
                android:inputType="number"
                android:maxLength="2"
                android:maxLines="1" />
        </com.google.android.material.textfield.TextInputLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espacio_xl"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCancelarDivision"
                style="@style/Boton.Outlined"
                android:layout_width="0dp"
                android:layout_height="@dimen/toque_minimo"
                android:layout_weight="1"
                android:text="@string/cobro_salir_cancelar" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnConfirmarDivision"
                style="@style/Boton.Primario"
                android:layout_width="0dp"
                android:layout_height="@dimen/toque_minimo"
                android:layout_marginStart="@dimen/espacio_s"
                android:layout_weight="1"
                android:text="@string/cobro_dividir_confirmar" />
        </LinearLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
