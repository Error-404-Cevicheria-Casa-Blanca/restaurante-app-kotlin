<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- La app del mesero usa SOLO tema claro (docs/diseno/DISENO-UI.md). -->
    <style name="Base.Theme.LaCasaBlancaMesero" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorOnPrimary">@color/on_primary</item>
        <item name="colorPrimaryContainer">@color/primary_container</item>
        <item name="colorOnPrimaryContainer">@color/on_primary</item>
        <item name="colorSecondary">@color/accent_lima</item>
        <item name="colorSecondaryContainer">@color/secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/primary_dark</item>
        <item name="android:colorBackground">@color/background</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/texto_principal</item>
        <item name="colorOnSurfaceVariant">@color/texto_secundario</item>
        <item name="colorError">@color/error</item>
        <item name="colorErrorContainer">@color/error_container</item>
        <item name="colorOnErrorContainer">@color/on_error_container</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.LaCasaBlanca.Dialogo</item>
        <item name="android:statusBarColor">@color/primary</item>
        <item name="android:navigationBarColor">@color/background</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:forceDarkAllowed" tools:targetApi="q">false</item>
    </style>

    <style name="Theme.LaCasaBlancaMesero" parent="Base.Theme.LaCasaBlancaMesero" />

    <!-- Tipografia -->
    <style name="Texto.TituloPantalla" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:textColor">@color/texto_principal</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Texto.TituloTarjeta" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textColor">@color/texto_principal</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Texto.Cuerpo" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">@color/texto_principal</item>
    </style>

    <style name="Texto.Secundario" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">@color/texto_secundario</item>
    </style>

    <style name="Texto.Etiqueta" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:textColor">@color/texto_secundario</item>
    </style>

    <style name="Texto.Marca" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:textColor">@color/texto_sobre_primario</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">26sp</item>
    </style>

    <style name="Texto.MarcaTablet" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:textColor">@color/texto_sobre_primario</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">32sp</item>
    </style>

    <style name="Texto.LemaMarca" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">@color/texto_sobre_primario_suave</item>
        <item name="android:textStyle">italic</item>
    </style>

    <style name="Texto.Badge" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Texto.PestanaLogin" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Texto.PestanaZona" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Dialogos Material 3: esquinas redondeadas y boton de aceptar en color de marca -->
    <style name="ThemeOverlay.LaCasaBlanca.Dialogo" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="alertDialogStyle">@style/MaterialAlertDialog.LaCasaBlanca</item>
    </style>

    <style name="MaterialAlertDialog.LaCasaBlanca" parent="MaterialAlertDialog.Material3">
        <item name="shapeAppearance">@style/ShapeAppearance.LaCasaBlanca.Dialogo</item>
        <item name="shapeAppearanceOverlay">@null</item>
    </style>

    <style name="ShapeAppearance.LaCasaBlanca.Dialogo" parent="ShapeAppearance.Material3.MediumComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">24dp</item>
    </style>

    <!-- Botones -->
    <style name="Boton.Primario" parent="Widget.Material3.Button">
        <item name="android:layout_height">@dimen/alto_boton_primario</item>
        <item name="cornerRadius">@dimen/radio_boton</item>
        <item name="backgroundTint">@color/selector_fondo_boton_primario</item>
        <item name="android:textColor">@color/selector_texto_boton_primario</item>
        <item name="iconTint">@color/selector_texto_boton_primario</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">@dimen/texto_cuerpo</item>
    </style>

    <style name="Boton.Secundario" parent="Widget.Material3.Button.TextButton">
        <item name="android:layout_height">@dimen/toque_minimo</item>
        <item name="cornerRadius">@dimen/radio_boton</item>
        <item name="backgroundTint">@color/surface_container_low</item>
        <item name="android:textColor">@color/primary</item>
        <item name="iconTint">@color/primary</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Boton.BarraAccion" parent="Widget.Material3.Button.TextButton">
        <item name="android:layout_height">@dimen/toque_minimo</item>
        <item name="android:minWidth">@dimen/toque_minimo</item>
        <item name="android:minHeight">@dimen/toque_minimo</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textColor">@color/stitch_primary</item>
        <item name="android:textSize">@dimen/texto_secundario</item>
        <item name="iconTint">@color/stitch_primary</item>
        <item name="backgroundTint">@color/barra_accion_fondo</item>
        <item name="cornerRadius">@dimen/radio_boton</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Boton.BarraSalir" parent="Widget.Material3.Button.TextButton">
        <item name="android:layout_height">@dimen/toque_minimo</item>
        <item name="android:minWidth">@dimen/toque_minimo</item>
        <item name="android:minHeight">@dimen/toque_minimo</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textColor">@color/on_error_container</item>
        <item name="android:textSize">@dimen/texto_secundario</item>
        <item name="iconTint">@color/on_error_container</item>
        <item name="backgroundTint">@color/barra_salir_fondo</item>
        <item name="cornerRadius">@dimen/radio_boton</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Boton.AgregarPlato" parent="Widget.Material3.Button">
        <item name="android:layout_height">@dimen/toque_minimo</item>
        <item name="android:minWidth">@dimen/toque_minimo</item>
        <item name="android:minHeight">@dimen/toque_minimo</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="cornerRadius">@dimen/espacio_m</item>
        <item name="backgroundTint">@color/selector_fondo_boton_agregar</item>
        <item name="android:textColor">@color/selector_texto_boton_agregar</item>
        <item name="iconTint">@color/selector_texto_boton_agregar</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Boton.PinTecla" parent="Widget.Material3.Button">
        <item name="android:layout_height">@dimen/alto_pin_tecla</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">@dimen/alto_pin_tecla</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="cornerRadius">@dimen/espacio_m</item>
        <item name="backgroundTint">@color/chip_pin_tecla</item>
        <item name="android:textColor">@color/on_surface</item>
        <item name="android:textSize">22sp</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="Boton.PinAccion" parent="Widget.Material3.Button">
        <item name="android:layout_height">@dimen/alto_pin_tecla</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">@dimen/alto_pin_tecla</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="cornerRadius">@dimen/espacio_m</item>
        <item name="backgroundTint">@color/chip_pin_accion</item>
        <item name="android:textColor">@color/on_surface_variant</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <!-- Tarjetas -->
    <style name="Tarjeta.Superficie" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">@dimen/radio_tarjeta</item>
        <item name="cardElevation">@dimen/elevacion_tarjeta</item>
        <item name="cardBackgroundColor">@color/surface</item>
        <item name="strokeColor">@color/borde_suave</item>
        <item name="strokeWidth">@dimen/borde_tarjeta</item>
    </style>

    <style name="Tarjeta.Login" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">@dimen/radio_tarjeta_login</item>
        <item name="cardElevation">@dimen/elevacion_tarjeta_login</item>
        <item name="cardBackgroundColor">@color/surface</item>
        <item name="strokeColor">@color/outline_variant</item>
        <item name="strokeWidth">@dimen/borde_tarjeta</item>
    </style>

</resources>
