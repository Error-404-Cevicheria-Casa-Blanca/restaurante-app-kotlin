<?xml version="1.0" encoding="utf-8"?>
<!-- El token JWT cifrado NO se respalda ni se transfiere: la clave vive en el Keystore. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude
            domain="file"
            path="datastore/sesion_mesero.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <exclude
            domain="file"
            path="datastore/sesion_mesero.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
